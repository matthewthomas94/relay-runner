#!/bin/bash
# relay-orchestrator -- Sub-agent orchestrator daemon launcher.
#
# Usage:
#   relay-orchestrator                # Run the daemon in the foreground (used by launchd)
#   relay-orchestrator --install      # First-run install: skills + MCP + launchd plist + load
#   relay-orchestrator --uninstall    # Reverse --install
#   relay-orchestrator --start        # Load the launchd plist (start daemon in background)
#   relay-orchestrator --stop         # Unload the launchd plist (stop daemon)
#   relay-orchestrator --status       # Print quick status (process, port, recent log)
#
# The daemon is the Symphony-style sub-agent orchestrator at services/orchestrator.py.
# It reuses the same venv and Python that scripts/relay-bridge installs, so we
# delegate venv bootstrap to that script via `--venv-only`.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

USER_DATA_DIR="$HOME/Library/Application Support/relay-runner"
SERVICES_DIR="$USER_DATA_DIR/services"
RELOCATABLE_PYTHON="$USER_DATA_DIR/python/bin/python3"
VENV_PYTHON="$SERVICES_DIR/.venv/bin/python"

ORCH_DIR="$USER_DATA_DIR/orchestrator"
LOG_FILE="/tmp/relay_orchestrator.log"
ERR_FILE="/tmp/relay_orchestrator.err"
PORT_FILE="/tmp/relay_orchestrator.port"

PLIST_LABEL="com.relay.orchestrator"
PLIST_PATH="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"

CMDS_DIR="$HOME/.claude/commands"
DISPATCH_MD="$CMDS_DIR/relay-dispatch.md"
WORKFLOW_MD="$CMDS_DIR/relay-workflow.md"
# Legacy slash command from the prior project-linking flow; removed at
# install time so stale prompts don't surface in Claude sessions.
LEGACY_LINK_MD="$CMDS_DIR/relay-link-project.md"

# -- Common helpers --

ensure_venv() {
    # Delegate venv bootstrap to relay-bridge. It's already battle-tested for the
    # same Python deps; --venv-only short-circuits before voice features start.
    "$SCRIPT_DIR/relay-bridge" --venv-only
    if [ ! -x "$VENV_PYTHON" ]; then
        echo "[relay-orchestrator] venv bootstrap failed — see relay-bridge output." >&2
        exit 1
    fi
}

find_claude_bin() {
    if [ -x "$HOME/.local/bin/claude" ]; then
        echo "$HOME/.local/bin/claude"
    elif command -v claude >/dev/null 2>&1; then
        command -v claude
    else
        echo ""
    fi
}

find_orchestrator_mcp_bin() {
    # Bundled (Contents/SharedSupport/scripts → ../../MacOS/relay-orchestrator-mcp).
    local bundled="$SCRIPT_DIR/../../MacOS/relay-orchestrator-mcp"
    if [ -x "$bundled" ]; then
        echo "$(cd "$(dirname "$bundled")" && pwd)/relay-orchestrator-mcp"
        return
    fi
    for cfg in release debug; do
        local dev="$PROJECT_ROOT/.build/$cfg/relay-orchestrator-mcp"
        if [ -x "$dev" ]; then
            echo "$(cd "$(dirname "$dev")" && pwd)/relay-orchestrator-mcp"
            return
        fi
    done
    echo ""
}

# -- Subcommands --

install_skills() {
    local mode="${1:-if-missing}"
    mkdir -p "$CMDS_DIR"

    # Always remove the legacy link-project command if present — even on
    # if-missing installs — so old prompts don't shadow the new ones.
    rm -f "$LEGACY_LINK_MD"

    if [ "$mode" = "force" ] || [ ! -f "$DISPATCH_MD" ]; then
        cat > "$DISPATCH_MD" <<'DISPATCH_MD_EOF'
Dispatch a ticket from the current repo's local kanban board (`.orchestrator/<ticket_id>.md`) to a relay-runner sub-agent. The orchestrator creates an isolated git worktree, renders the workflow prompt, and runs `claude` autonomously inside it.

## When to use this

The user said something like "work on RR-6" or "have an agent take RR-6". This command picks up the ticket, runs it in an isolated worktree, and returns once the sub-agent finishes (or you can leave it running and check `list_runs` later).

## Steps

1. **Identify the ticket.** Extract the ticket id (e.g. `RR-6`) from the user's message. If multiple are mentioned, dispatch each via separate calls.

2. **Resolve the repo path.** The orchestrator needs an absolute path to the repo whose `.orchestrator/` board owns the ticket — that's the repo the current session is operating in. From the current working directory:

   ```bash
   git rev-parse --show-toplevel
   ```

   Confirm `<repo>/.orchestrator/<ticket_id>.md` exists before dispatching.

3. **Dispatch.** Call `mcp__relay-orchestrator__dispatch_ticket(ticket_id="RR-6", repo_path="<absolute path>")`. The tool returns:
   - `already_active: true` → there's already a run going for this ticket. Tell the user the existing run_id and stop.
   - `already_active: false` → a fresh run is started; the response includes `run_id`, `state` (Claimed → Running), `workspace_path`, `branch`.

4. **Report briefly.** One sentence: "Started RR-6 in worktree `<path>`, run_id N." Don't wait — the run is async. The user can ask "How's RR-6?" later and you'll call `get_run` / `list_runs`.

## Status checks

When the user asks "what are the agents doing?" / "how's RR-6?":
- `mcp__relay-orchestrator__list_runs(state="Running")` → all active runs
- `mcp__relay-orchestrator__get_run(run_id=N)` → details of a specific run, including `state`, `exit_code`, `last_error`, `log_path`

If a run finished, also peek at the worktree (path is in the run record) to see the diff: `git -C <workspace_path> diff <default_branch>...`.

## Cancelling

`mcp__relay-orchestrator__cancel_run(run_id=N)` terminates the worker (SIGTERM, then SIGKILL) and prunes the worktree by default.

## Notes

- The worker runs with `--dangerously-skip-permissions` inside an isolated branch (`relay/<sanitized-id>`); changes are local-only and never pushed automatically.
- The default workflow template is at `~/Library/Application Support/relay-runner/orchestrator/WORKFLOW.md`. A repo-local `WORKFLOW.md` overrides the default for that repo.
- The worker mutates the ticket file: flips status to `in_progress` on start, then to `done` (or leaves `in_progress` if partial) and appends a `## Run log` section before exiting. Both edits are committed to the worker's branch.
- For the broader "discuss → write → dispatch → integrate" workflow this command sits inside, see `/relay-workflow`.
DISPATCH_MD_EOF
        echo "[relay-orchestrator] wrote $DISPATCH_MD"
    fi

    if [ "$mode" = "force" ] || [ ! -f "$WORKFLOW_MD" ]; then
        cat > "$WORKFLOW_MD" <<'WORKFLOW_MD_EOF'
**MANDATORY orchestrator-mode prime.** Invoke this skill on the FIRST conversational turn of any session where the `mcp__relay-orchestrator__*` tools are registered — the user installed relay-runner specifically so that this is the default operating mode. The orchestrator workflow (discuss → write tickets to `.orchestrator/` → dispatch sub-agents → integrate) is the *only* intended workflow for relay-runner installations. The user should not have to ask for it, mention "dispatch", or invoke any slash command — having relay-runner installed *is* the request to operate this way.

Also re-trigger when the user discusses concrete work to be done ("let's tackle…", "what should we work on", "I need to fix…", "we should add…"), mentions tickets / issues / the backlog / the board, says "dispatch / hand off / delegate / kick off / spin up an agent", references a ticket id like RR-6, or asks "what are the agents doing" / "how's RR-6" / "stop RR-6".

Do NOT trigger when: relay-orchestrator MCP isn't registered (`claude mcp get relay-orchestrator` fails), or the user has explicitly said "stay in this session, don't dispatch" / "don't use the orchestrator". A small inline edit the user asks for directly is still fine to do here — the orchestrator workflow says "dispatch when the round-trip pays off", not "always dispatch".

## The four-step workflow

You (this main session) are the orchestrator. Each `claude` worker spawned by `dispatch_ticket` is a one-shot sub-agent with no memory of this conversation.

1. **Discuss.** Talk through what needs to happen. Surface assumptions, push back when something's underspecified, propose alternatives. Don't jump to writing tickets until the work is concrete.
2. **Write tickets.** When the discussion settles on a unit of work, create a ticket file under `<repo>/.orchestrator/<TICKET_ID>.md` following the schema in `docs/specs/orchestrator-tickets.md` (YAML frontmatter + `## Description` + `## Acceptance criteria`). Commit the new ticket to the working branch so the board reflects it. Use the next available id from `<repo>/.orchestrator/config.toml`'s `next_id` and bump that counter in the same commit. Each ticket should be small enough that a sub-agent can complete it in one pass without further clarification.
3. **Dispatch.** Call `mcp__relay-orchestrator__dispatch_ticket(ticket_id="RR-N", repo_path="<repo absolute path>")`. If the ticket body wouldn't survive cold without this conversation, pass `context="..."` with the relevant background. Multiple parallel dispatches are supported (no concurrency cap), but expect merge conflicts when sub-agents touch overlapping code.
4. **Integrate.** Each sub-agent commits to its `relay/<id>` branch — both the code change and the ticket-file update (status flipped to `done` + a `## Run log` entry). Merge those branches into the working branch in a sensible order, resolve conflicts intentionally (don't just accept "theirs"), then clean up the worktree + delete the throwaway branch.

## When NOT to dispatch

A small change you can do inline in this session is usually faster than dispatching. Each sub-agent is a fresh `claude` process with cold-start overhead, its own context window (more tokens against your quota), and zero awareness of what's been discussed here. Dispatch when:
- The work is large enough that the round-trip pays off.
- You want an in-repo audit trail (the ticket file + run log) without doing it by hand.
- You want isolation (an autonomous run that can't disturb the main repo's working copy).

For a one-line typo fix or a doc tweak, just edit and commit in this session.

## Status checks

- `mcp__relay-orchestrator__list_runs(state="Running")` — what's currently dispatched
- `mcp__relay-orchestrator__get_run(run_id=N)` — details of one run, including `state`, `exit_code`, and `log_path`
- `git -C <workspace_path> log --oneline <default_branch>..HEAD` from the run record — what the worker actually committed (code + ticket update)

## Boundaries

- Don't push `relay/<id>` branches; integrate first, then delete.
- Sub-agents are constrained by `services/orchestrator_workflow.md` (or a repo-local `WORKFLOW.md`) — they may only edit their own ticket file under `.orchestrator/`. Other tickets and the board layout belong to the orchestrator (you).

## On invocation

If the user typed `/relay-workflow` explicitly, give a brief one-line acknowledgement ("orchestrator mode primed — what are we working on?") and continue.

If you're triggering this skill *implicitly* mid-conversation (the user didn't type the command, you matched the description), stay quiet about the skill itself — just internalize the workflow and proceed naturally. The user shouldn't see "I've activated relay-workflow"; they should just notice you offering to write tickets and dispatch when the work is right-sized for it.
WORKFLOW_MD_EOF
        echo "[relay-orchestrator] wrote $WORKFLOW_MD"
    fi
}

uninstall_skills() {
    rm -f "$DISPATCH_MD" "$WORKFLOW_MD" "$LEGACY_LINK_MD"
    # Also remove legacy file from before the relay-orchestrate → relay-dispatch rename.
    rm -f "$CMDS_DIR/relay-orchestrate.md"
    echo "[relay-orchestrator] removed slash command files."
}

register_mcp() {
    local claude_bin
    claude_bin="$(find_claude_bin)"
    local mcp_bin
    mcp_bin="$(find_orchestrator_mcp_bin)"

    if [ -z "$claude_bin" ]; then
        echo "[relay-orchestrator] claude CLI not found — skipping MCP registration." >&2
        return 0
    fi
    if [ -z "$mcp_bin" ]; then
        echo "[relay-orchestrator] relay-orchestrator-mcp binary not found." >&2
        echo "[relay-orchestrator] Build with: swift build --product relay-orchestrator-mcp" >&2
        return 0
    fi

    if "$claude_bin" mcp get relay-orchestrator >/dev/null 2>&1; then
        echo "[relay-orchestrator] MCP server already registered."
        return 0
    fi

    if "$claude_bin" mcp add -s user relay-orchestrator -- "$mcp_bin" >/dev/null 2>&1; then
        echo "[relay-orchestrator] Registered MCP server: relay-orchestrator → $mcp_bin"
    else
        echo "[relay-orchestrator] MCP server registration failed (non-fatal)." >&2
        echo "[relay-orchestrator] Try manually:" >&2
        echo "    $claude_bin mcp add -s user relay-orchestrator -- $mcp_bin" >&2
    fi
}

unregister_mcp() {
    local claude_bin
    claude_bin="$(find_claude_bin)"
    [ -z "$claude_bin" ] && return 0
    "$claude_bin" mcp remove -s user relay-orchestrator >/dev/null 2>&1 || true
    echo "[relay-orchestrator] removed MCP server registration."
}

write_plist() {
    mkdir -p "$(dirname "$PLIST_PATH")"
    cat > "$PLIST_PATH" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${PLIST_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${SCRIPT_DIR}/relay-orchestrator</string>
        <string>--run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>${LOG_FILE}</string>
    <key>StandardErrorPath</key>
    <string>${ERR_FILE}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
PLIST_EOF
    echo "[relay-orchestrator] wrote launchd plist: $PLIST_PATH"
}

remove_plist() {
    rm -f "$PLIST_PATH"
    echo "[relay-orchestrator] removed launchd plist."
}

launchctl_load() {
    if [ ! -f "$PLIST_PATH" ]; then
        echo "[relay-orchestrator] no plist at $PLIST_PATH — run --install first." >&2
        return 1
    fi
    # bootstrap is the modern replacement for `load -w`. Errors when already loaded;
    # fall back to a quiet kickstart in that case.
    if launchctl bootstrap "gui/$(id -u)" "$PLIST_PATH" 2>/dev/null; then
        echo "[relay-orchestrator] daemon loaded via launchctl bootstrap."
    else
        launchctl kickstart -k "gui/$(id -u)/${PLIST_LABEL}" >/dev/null 2>&1 || true
        echo "[relay-orchestrator] daemon already loaded — restarted via kickstart."
    fi
}

launchctl_unload() {
    launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null || true
    echo "[relay-orchestrator] daemon unloaded."
}

cmd_status() {
    echo "Daemon process:"
    if pgrep -f 'services/orchestrator.py' >/dev/null 2>&1; then
        pgrep -fl 'services/orchestrator.py' | head -3 | sed 's/^/  /'
    else
        echo "  (not running)"
    fi
    echo "Port file ($PORT_FILE):"
    if [ -f "$PORT_FILE" ]; then
        echo "  port=$(cat "$PORT_FILE")"
    else
        echo "  (absent)"
    fi
    echo "Plist: $([ -f "$PLIST_PATH" ] && echo installed || echo missing)"
    echo "Recent stderr ($ERR_FILE):"
    tail -5 "$ERR_FILE" 2>/dev/null | sed 's/^/  /' || echo "  (no log yet)"
}

cmd_run() {
    ensure_venv
    mkdir -p "$ORCH_DIR"
    exec "$VENV_PYTHON" "$PROJECT_ROOT/services/orchestrator.py" "$@"
}

cmd_install() {
    ensure_venv
    install_skills if-missing
    register_mcp
    write_plist
    launchctl_load
    echo
    echo "[relay-orchestrator] install complete. Try:"
    echo "    relay-orchestrator --status"
    echo
    echo "From any Claude Code session:"
    echo "    /relay-workflow       (prime the discuss → write → dispatch → integrate pattern)"
    echo "    /relay-dispatch       (dispatch a ticket from .orchestrator/ to a sub-agent)"
}

cmd_uninstall() {
    launchctl_unload
    remove_plist
    unregister_mcp
    uninstall_skills
    rm -f "$PORT_FILE"
    echo "[relay-orchestrator] uninstall complete."
}

# -- Dispatch --

mode="${1:-run}"
case "$mode" in
    --install)            shift || true; cmd_install   "$@" ;;
    --uninstall)          shift || true; cmd_uninstall "$@" ;;
    --start)              shift || true; ensure_venv; launchctl_load ;;
    --stop)               shift || true; launchctl_unload ;;
    --status)             shift || true; cmd_status ;;
    --install-skills)     shift || true; install_skills force ;;
    --run|run|"")
        shift || true
        cmd_run "$@"
        ;;
    -h|--help)
        sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
        ;;
    *)
        echo "Unknown subcommand: $mode" >&2
        echo "Try: relay-orchestrator --help" >&2
        exit 64
        ;;
esac
