#!/bin/bash
# relay-orchestrator -- Sub-agent orchestrator daemon launcher.
#
# Usage:
#   relay-orchestrator                # Run the daemon in the foreground (used by launchd)
#   relay-orchestrator --install      # First-run install: skills + MCP + launchd plist + load
#   relay-orchestrator --uninstall    # Reverse --install
#   relay-orchestrator --start        # Load the launchd plist (start daemon in background)
#   relay-orchestrator --stop         # Unload the launchd plist (stop daemon)
#   relay-orchestrator --restart-if-idle  # Restart launchd daemon only when no workers are active
#   relay-orchestrator --status       # Print quick status (process, port, recent log)
#
# The daemon is the Symphony-style sub-agent orchestrator at services/orchestrator.py.
# It reuses the same venv and Python that scripts/relay-bridge installs, so we
# delegate venv bootstrap to that script via `--venv-only`.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

USER_DATA_DIR="$HOME/Library/Application Support/relay-runner"
SERVICES_DIR="$USER_DATA_DIR/services"
RELOCATABLE_PYTHON="$USER_DATA_DIR/python/bin/python3"
VENV_PYTHON="$SERVICES_DIR/.venv/bin/python"
export PYTHONDONTWRITEBYTECODE=1

# Progress emitted here belongs to the complete install workflow. Nested
# relay-bridge progress is mapped into the first 80% by ensure_venv; later
# markers describe real outer phases. Successful process exit, not a marker,
# remains the Swift installer's completion signal.
emit_progress() {
    echo "RELAY_PROGRESS:$1:$2" >&2
}

ORCH_DIR="$USER_DATA_DIR/orchestrator"
LOG_FILE="${RELAY_ORCHESTRATOR_LOG_FILE:-/tmp/relay_orchestrator.log}"
ERR_FILE="${RELAY_ORCHESTRATOR_ERR_FILE:-/tmp/relay_orchestrator.err}"
PORT_FILE="${RELAY_ORCHESTRATOR_PORT_FILE:-/tmp/relay_orchestrator.port}"
HEALTH_WAIT_ATTEMPTS="${RELAY_ORCHESTRATOR_HEALTH_WAIT_ATTEMPTS:-100}"

PLIST_LABEL="com.relay.orchestrator"
PLIST_PATH="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"
LAUNCHCTL_SERVICE="gui/$(id -u)/${PLIST_LABEL}"

# relay-dispatch / relay-workflow command and skill files. relay-bridge
# installs them (with its edit-preserving refresh); uninstall removes them.
CMDS_DIR="$HOME/.claude/commands"
DISPATCH_MD="$CMDS_DIR/relay-dispatch.md"
WORKFLOW_MD="$CMDS_DIR/relay-workflow.md"
CODEX_SKILLS_DIR="$HOME/.codex/skills"
CODEX_DISPATCH_DIR="$CODEX_SKILLS_DIR/relay-dispatch"
CODEX_WORKFLOW_DIR="$CODEX_SKILLS_DIR/relay-workflow"
# Legacy Relay slash commands: relay-link-project.md is from the prior
# project-linking flow; relay-orchestrate.md is from before the
# relay-orchestrate → relay-dispatch rename.
LEGACY_LINK_MD="$CMDS_DIR/relay-link-project.md"
LEGACY_ORCHESTRATE_MD="$CMDS_DIR/relay-orchestrate.md"

# -- Common helpers --

support_file_mtime() {
    stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1" 2>/dev/null || echo 0
}

support_file_size() {
    stat -f '%z' "$1" 2>/dev/null || stat -c '%s' "$1" 2>/dev/null || echo 0
}

support_safe_id() {
    [ "${#1}" -le 64 ] && [[ "$1" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ \
        || "$1" =~ ^inc-[0-9a-f]{12}$ \
        || "$1" =~ ^(shell|orchestrator)-[0-9]{10,}-[0-9]+$ ]]
}

acquire_support_journal_lock() {
    local directory="$1"
    local lock="$directory/.journal.lock"
    local attempts=0 now mtime stale
    while ! mkdir "$lock" 2>/dev/null; do
        now="$(date +%s)"
        mtime="$(support_file_mtime "$lock")"
        if [ "$mtime" -gt 0 ] && [ $((now - mtime)) -ge 30 ]; then
            stale="$directory/.journal.lock.stale-$$-$attempts"
            if mv "$lock" "$stale" 2>/dev/null; then
                rm -rf "$stale"
                continue
            fi
        fi
        attempts=$((attempts + 1))
        [ "$attempts" -lt 100 ] || return 1
        sleep 0.05
    done
}

release_support_journal_lock() {
    rm -rf "$1/.journal.lock"
}

prune_support_journals() {
    local directory="$1"
    local cutoff file mtime size total oldest oldest_mtime
    cutoff=$(($(date +%s) - 604800))
    for file in "$directory"/events-v1-*.jsonl; do
        [ -f "$file" ] || continue
        mtime="$(support_file_mtime "$file")"
        if [ "$mtime" -lt "$cutoff" ]; then
            rm -f "$file"
        fi
    done

    total=0
    for file in "$directory"/events-v1-*.jsonl; do
        [ -f "$file" ] || continue
        size="$(support_file_size "$file")"
        total=$((total + size))
    done
    while [ "$total" -gt 5242880 ]; do
        oldest=""
        oldest_mtime=""
        for file in "$directory"/events-v1-*.jsonl; do
            [ -f "$file" ] || continue
            mtime="$(support_file_mtime "$file")"
            if [ -z "$oldest" ] || [ "$mtime" -lt "$oldest_mtime" ] \
                || { [ "$mtime" -eq "$oldest_mtime" ] && [[ "$file" < "$oldest" ]]; }; then
                oldest="$file"
                oldest_mtime="$mtime"
            fi
        done
        [ -n "$oldest" ] || break
        size="$(support_file_size "$oldest")"
        rm -f "$oldest"
        total=$((total - size))
    done
}

record_support_event() {
    local process="$1"
    local phase="$2"
    local outcome="$3"
    local provider="${4:-}"
    local python_version="${5:-}"
    local error_code="${6:-}"
    local directory="${RELAY_DIAGNOSTICS_DIR:-$USER_DATA_DIR/support-diagnostics/v1}"
    local app_session correlation provider_json incident_json retry_json raw_id redaction_count=0
    local attributes_json='{}' summary_json='null'
    case "$process:$phase:$outcome" in
        shell:setup:started|shell:setup:ready|shell:setup:failed) ;;
        shell:orchestrator_preflight:failed)
            if [[ ! "$python_version" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
                python_version="unknown"
                redaction_count=$((redaction_count + 1))
            fi
            if [[ ! "$error_code" =~ ^[A-Za-z][A-Za-z0-9_]{0,63}$ ]]; then
                error_code="ImportError"
                redaction_count=$((redaction_count + 1))
            fi
            attributes_json="{\"error_code\":\"$error_code\",\"version\":\"$python_version\"}"
            summary_json="\"orchestrator import preflight failed under Python $python_version\""
            ;;
        *) return 0 ;;
    esac
    raw_id="${RELAY_APP_SESSION_ID:-shell-$(date +%s)-$$}"
    if support_safe_id "$raw_id"; then app_session="$raw_id"; else app_session="redacted-id"; redaction_count=$((redaction_count + 1)); fi
    raw_id="${RELAY_CORRELATION_ID:-shell-$(date +%s)-$$}"
    if support_safe_id "$raw_id"; then correlation="$raw_id"; else correlation="redacted-id"; redaction_count=$((redaction_count + 1)); fi
    case "$provider" in
        codex|claude) provider_json="\"$provider\"" ;;
        *) provider_json="null"; [ -z "$provider" ] || redaction_count=$((redaction_count + 1)) ;;
    esac
    incident_json="null"
    if [ -n "${RELAY_INCIDENT_ID:-}" ]; then
        if support_safe_id "$RELAY_INCIDENT_ID"; then
            incident_json="\"$RELAY_INCIDENT_ID\""
        else
            incident_json='"redacted-id"'
            redaction_count=$((redaction_count + 1))
        fi
    fi
    case "${RELAY_RETRY_ATTEMPT:-}" in
        ''|0) retry_json="null" ;;
        *[!0-9]*) retry_json="null"; redaction_count=$((redaction_count + 1)) ;;
        *) retry_json="$RELAY_RETRY_ATTEMPT" ;;
    esac
    mkdir -p "$directory" 2>/dev/null || return 0
    chmod 700 "$directory" 2>/dev/null || true
    acquire_support_journal_lock "$directory" || return 0
    printf '{"app_session_id":"%s","attributes":%s,"correlation_id":"%s","incident_id":%s,"outcome":"%s","phase":"%s","process":"%s","provider":%s,"redaction_count":%s,"retry_attempt":%s,"schema_version":1,"summary":%s,"timestamp":"%s"}\n' \
        "$app_session" "$attributes_json" "$correlation" "$incident_json" "$outcome" "$phase" "$process" "$provider_json" "$redaction_count" "$retry_json" "$summary_json" \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        >> "$directory/events-v1-$process-$$.jsonl" 2>/dev/null || true
    chmod 600 "$directory/events-v1-$process-$$.jsonl" 2>/dev/null || true
    prune_support_journals "$directory"
    release_support_journal_lock "$directory"
}

ensure_support_correlation() {
    if [ -z "${RELAY_CORRELATION_ID:-}" ]; then
        RELAY_CORRELATION_ID="orchestrator-$(date +%s)-$$"
    fi
    support_safe_id "$RELAY_CORRELATION_ID" || RELAY_CORRELATION_ID="redacted-id"
    export RELAY_CORRELATION_ID
}

ensure_venv() {
    local nested_progress_max="${1:-100}"
    # Delegate venv bootstrap to relay-bridge. It's already battle-tested for the
    # same Python deps; --venv-only short-circuits before voice features start.
    # Reserve the remaining progress range for validation, provider tooling,
    # launchd installation, and the daemon health gate owned by this process.
    RELAY_ORCHESTRATOR_PREFLIGHT_REQUIRED=1 RELAY_PROGRESS_MAX_PERCENT="$nested_progress_max" \
        "$SCRIPT_DIR/relay-bridge" --venv-only
    if [ ! -x "$VENV_PYTHON" ]; then
        echo "[relay-orchestrator] venv bootstrap failed — see relay-bridge output." >&2
        return 1
    fi
    if [ "$nested_progress_max" -lt 100 ]; then
        emit_progress 82 "Validating runtime..."
    fi
    orchestrator_import_preflight
}

orchestrator_import_preflight() {
    local python_version import_error
    python_version="$("$VENV_PYTHON" -c 'import platform; print(platform.python_version())' 2>/dev/null || true)"
    [[ "$python_version" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] || python_version="unknown"

    if import_error="$(PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}" "$VENV_PYTHON" - "$PROJECT_ROOT" <<'PY'
import importlib
import sys

sys.path.insert(0, sys.argv[1])
try:
    importlib.import_module("services.orchestrator")
except BaseException as error:
    print(type(error).__name__)
    raise SystemExit(1)
PY
    )"; then
        return 0
    fi

    import_error="$(printf '%s' "$import_error" | tail -1 | tr -cd '[:alnum:]_')"
    [[ "$import_error" =~ ^[A-Za-z][A-Za-z0-9_]{0,63}$ ]] || import_error="ImportError"
    echo "[relay-orchestrator] orchestrator import preflight failed under Python $python_version ($import_error)." >&2
    echo "[relay-orchestrator] Setup stopped before launch; retry after repairing the Relay service runtime." >&2
    record_support_event shell orchestrator_preflight failed "" "$python_version" "$import_error"
    return 1
}

find_claude_bin() {
    # Match relay-bridge and the app: installer symlink, then Homebrew.
    local candidate
    for candidate in "$HOME/.local/bin/claude" /opt/homebrew/bin/claude /usr/local/bin/claude; do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return
        fi
    done
    if command -v claude >/dev/null 2>&1; then
        command -v claude
    else
        echo ""
    fi
}

find_codex_bin() {
    if [ -x "/Applications/ChatGPT.app/Contents/Resources/codex" ]; then
        echo "/Applications/ChatGPT.app/Contents/Resources/codex"
    elif [ -x "/Applications/Codex.app/Contents/Resources/codex" ]; then
        echo "/Applications/Codex.app/Contents/Resources/codex"
    elif command -v codex >/dev/null 2>&1; then
        command -v codex
    else
        echo ""
    fi
}

# -- Subcommands --

install_skills() {
    # The command/skill text and the install policy live in relay-bridge,
    # generated from services/instructions/ by scripts/build-instructions.
    if [ "${1:-refresh}" = "force" ]; then
        "$SCRIPT_DIR/relay-bridge" --install-skills
    else
        "$SCRIPT_DIR/relay-bridge" --refresh-skills
    fi
}

uninstall_skills() {
    rm -f "$DISPATCH_MD" "$WORKFLOW_MD" "$LEGACY_LINK_MD" "$LEGACY_ORCHESTRATE_MD"
    rm -rf "$CODEX_DISPATCH_DIR" "$CODEX_WORKFLOW_DIR"
    echo "[relay-orchestrator] removed slash command files."
}

register_mcp() {
    # relay-bridge compares each agent's effective registration with this
    # app's binary, repairs a stale Relay-owned entry at its scope, and
    # reports a project-owned conflict instead of claiming a fix.
    "$SCRIPT_DIR/relay-bridge" --register-mcp \
        relay-orchestrator relay-orchestrator-mcp "relay-orchestrator"
}

unregister_mcp() {
    local claude_bin
    claude_bin="$(find_claude_bin)"
    if [ -n "$claude_bin" ]; then
        "$claude_bin" mcp remove -s user relay-orchestrator >/dev/null 2>&1 || true
    fi
    local codex_bin
    codex_bin="$(find_codex_bin)"
    if [ -n "$codex_bin" ]; then
        "$codex_bin" mcp remove relay-orchestrator >/dev/null 2>&1 || true
    fi
    echo "[relay-orchestrator] removed MCP server registration."
}

write_plist() {
    mkdir -p "$(dirname "$PLIST_PATH")"
    cat > "$PLIST_PATH" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${PLIST_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${SCRIPT_DIR}/relay-orchestrator</string>
        <string>--run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>${LOG_FILE}</string>
    <key>StandardErrorPath</key>
    <string>${ERR_FILE}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONDONTWRITEBYTECODE</key>
        <string>1</string>
    </dict>
</dict>
</plist>
PLIST_EOF
    echo "[relay-orchestrator] wrote launchd plist: $PLIST_PATH"
}

remove_plist() {
    rm -f "$PLIST_PATH"
    echo "[relay-orchestrator] removed launchd plist."
}

launchctl_load() {
    if [ ! -f "$PLIST_PATH" ]; then
        echo "[relay-orchestrator] no plist at $PLIST_PATH — run --install first." >&2
        return 1
    fi
    # bootstrap is the modern replacement for `load -w`. A failed bootstrap
    # can mean either an already-loaded job or a stale launchd registration;
    # distinguish those cases so failures never masquerade as readiness.
    if launchctl bootstrap "gui/$(id -u)" "$PLIST_PATH" 2>/dev/null; then
        echo "[relay-orchestrator] daemon loaded via launchctl bootstrap."
    elif launchctl_loaded; then
        if ! launchctl kickstart -k "$LAUNCHCTL_SERVICE" >/dev/null 2>&1; then
            echo "[relay-orchestrator] launchd job is loaded but could not be restarted." >&2
            return 1
        fi
        echo "[relay-orchestrator] daemon already loaded — restarted via kickstart."
    else
        launchctl bootout "$LAUNCHCTL_SERVICE" >/dev/null 2>&1 || true
        if ! launchctl bootstrap "gui/$(id -u)" "$PLIST_PATH" 2>/dev/null; then
            echo "[relay-orchestrator] launchd could not load $PLIST_PATH." >&2
            echo "[relay-orchestrator] Run --status and inspect $ERR_FILE before retrying setup." >&2
            return 1
        fi
        echo "[relay-orchestrator] repaired stale launchd registration."
    fi
}

launchctl_loaded() {
    launchctl print "$LAUNCHCTL_SERVICE" >/dev/null 2>&1
}

active_worker_count() {
    local db="$ORCH_DIR/runs.db"
    if [ ! -f "$db" ]; then
        echo 0
        return 0
    fi
    "$VENV_PYTHON" - "$db" <<'PY'
import sqlite3
import sys

db = sys.argv[1]
try:
    conn = sqlite3.connect(db)
    row = conn.execute(
        "SELECT COUNT(*) FROM runs WHERE state IN ('Claimed', 'Running')"
    ).fetchone()
except sqlite3.OperationalError as exc:
    if "no such table" in str(exc).lower():
        print(0)
        sys.exit(0)
    print(f"unknown: {exc}", file=sys.stderr)
    sys.exit(2)
else:
    print(int(row[0] if row else 0))
PY
}

wait_for_health() {
    local port
    # A cold launch repeats the venv integrity check before binding the port.
    # Keep this bounded, but allow the same roughly 20-second readiness window
    # used by Program Workspace before reporting a false install failure.
    for _ in $(seq 1 "$HEALTH_WAIT_ATTEMPTS"); do
        if [ -f "$PORT_FILE" ]; then
            port="$(cat "$PORT_FILE" 2>/dev/null || true)"
        else
            port=""
        fi
        if [ -n "$port" ] \
           && curl -fsS --max-time 1 "http://127.0.0.1:${port}/v1/health" >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.2
    done
    echo "[relay-orchestrator] daemon did not become healthy within the bounded startup window." >&2
    if launchctl_loaded; then
        echo "[relay-orchestrator] launchd job is loaded; recent daemon diagnostics:" >&2
    else
        echo "[relay-orchestrator] launchd job is not loaded; retry --install after checking launchd." >&2
    fi
    tail -8 "$ERR_FILE" 2>/dev/null | sed 's/^/[relay-orchestrator]   /' >&2 || true
    return 1
}

launchctl_restart_if_idle() {
    if [ ! -f "$PLIST_PATH" ]; then
        write_plist
    fi

    if ! launchctl_loaded; then
        launchctl_load
        wait_for_health
        return $?
    fi

    local active
    if ! active="$(active_worker_count)"; then
        echo "[relay-orchestrator] restart deferred: could not verify active worker state." >&2
        return 75
    fi
    if [ "${active:-0}" -gt 0 ]; then
        echo "[relay-orchestrator] restart deferred: ${active} active worker(s)." >&2
        return 75
    fi

    if ! launchctl kickstart -k "$LAUNCHCTL_SERVICE" >/dev/null 2>&1; then
        echo "[relay-orchestrator] loaded daemon could not be restarted via launchd." >&2
        return 1
    fi
    echo "[relay-orchestrator] daemon restarted via kickstart."
    wait_for_health
}

launchctl_unload() {
    launchctl bootout "$LAUNCHCTL_SERVICE" 2>/dev/null || true
    echo "[relay-orchestrator] daemon unloaded."
}

cmd_status() {
    echo "Daemon process:"
    if pgrep -f 'services/orchestrator.py' >/dev/null 2>&1; then
        pgrep -fl 'services/orchestrator.py' | head -3 | sed 's/^/  /'
    else
        echo "  (not running)"
    fi
    echo "Port file ($PORT_FILE):"
    if [ -f "$PORT_FILE" ]; then
        echo "  port=$(cat "$PORT_FILE")"
    else
        echo "  (absent)"
    fi
    echo "Plist: $([ -f "$PLIST_PATH" ] && echo installed || echo missing)"
    echo "Launchd job: $(launchctl_loaded && echo loaded || echo not-loaded)"
    local status_port=""
    if [ -f "$PORT_FILE" ]; then
        status_port="$(cat "$PORT_FILE" 2>/dev/null || true)"
    fi
    if [ -n "$status_port" ] \
       && curl -fsS --max-time 1 "http://127.0.0.1:${status_port}/v1/health" >/dev/null 2>&1; then
        echo "Health endpoint: healthy"
    else
        echo "Health endpoint: unavailable"
    fi
    echo "Recent stderr ($ERR_FILE):"
    tail -5 "$ERR_FILE" 2>/dev/null | sed 's/^/  /' || echo "  (no log yet)"
}

cmd_run() {
    ensure_support_correlation
    if ! ensure_venv; then
        # launchd KeepAlive restarts only unsuccessful exits. Return cleanly on
        # a deterministic pre-main failure so it does not spin until setup is
        # repaired or explicitly retried.
        return 0
    fi
    mkdir -p "$ORCH_DIR"
    exec "$VENV_PYTHON" "$PROJECT_ROOT/services/orchestrator.py" "$@"
}

cmd_install() {
    ensure_support_correlation
    record_support_event shell setup started
    if ! ensure_venv 80; then
        record_support_event shell setup failed
        return 1
    fi
    emit_progress 85 "Installing Relay skills..."
    install_skills refresh
    emit_progress 88 "Registering provider tools..."
    register_mcp
    emit_progress 92 "Installing background service..."
    write_plist
    emit_progress 95 "Starting and checking background service..."
    set +e
    launchctl_restart_if_idle
    local restart_rc=$?
    set -e
    if [ "$restart_rc" -eq 75 ]; then
        echo "[relay-orchestrator] install complete; daemon restart deferred until active workers finish."
    elif [ "$restart_rc" -ne 0 ]; then
        record_support_event shell setup failed
        return "$restart_rc"
    fi
    emit_progress 98 "Finalizing setup..."
    record_support_event shell setup ready
    echo
    echo "[relay-orchestrator] install complete. Try:"
    echo "    relay-orchestrator --status"
    echo
    echo "From any Codex or Claude session:"
    echo "    relay-workflow        (prime the discuss → write → dispatch → integrate pattern)"
    echo "    relay-dispatch        (dispatch a ticket from .orchestrator/ to a sub-agent)"
}

cmd_uninstall() {
    launchctl_unload
    remove_plist
    unregister_mcp
    uninstall_skills
    rm -f "$PORT_FILE"
    echo "[relay-orchestrator] uninstall complete."
}

# -- Dispatch --

mode="${1:-run}"
case "$mode" in
    --install)            shift || true; cmd_install   "$@" ;;
    --uninstall)          shift || true; cmd_uninstall "$@" ;;
    --start)              shift || true; ensure_venv; launchctl_load ;;
    --restart-if-idle)    shift || true; ensure_venv; launchctl_restart_if_idle ;;
    --stop)               shift || true; launchctl_unload ;;
    --status)             shift || true; cmd_status ;;
    --install-skills)     shift || true; install_skills force ;;
    --run|run|"")
        shift || true
        cmd_run "$@"
        ;;
    -h|--help)
        sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
        ;;
    *)
        echo "Unknown subcommand: $mode" >&2
        echo "Try: relay-orchestrator --help" >&2
        exit 64
        ;;
esac
