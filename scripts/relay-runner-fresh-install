#!/bin/bash
# Supported preserving reinstall and recoverable Relay-owned state reset.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
APP_RUNTIME="$HOME/Library/Application Support/relay-runner/python/bin/python3"
APP_VENV="$HOME/Library/Application Support/relay-runner/services/.venv/bin/python"

for candidate in "$APP_RUNTIME" "$APP_VENV" /opt/homebrew/bin/python3 /usr/local/bin/python3; do
    if [[ -x "$candidate" ]]; then
        exec "$candidate" "$PROJECT_ROOT/services/fresh_install_cli.py" "$@"
    fi
done

echo "relay-runner-fresh-install requires Relay's bundled Python or a modern local Python" >&2
exit 1
