        sed "s|__RELAY_BRIDGE__|$relay_bridge_path|g" "$codex_bridge_md" > "$tmp" && mv "$tmp" "$codex_bridge_md"
    fi

    if [ "$mode" = "force" ] || [ ! -f "$codex_stop_md" ]; then
        cat > "$codex_stop_md" <<'CODEX_STOP_MD_EOF'
