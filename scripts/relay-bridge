#!/bin/bash
# relay-bridge -- Start voice I/O pipeline (STT sidecar + voice bridge).
#
# Usage:
#   relay-bridge                     # Relay daemon for Start Session / relay-bridge skills
#   relay-bridge --relay             # Same as default; kept for existing skill launchers
#   relay-bridge --venv-only         # Run venv bootstrap and exit 0 (used by onboarding)
#   relay-bridge --install-skills    # Force-write Relay skills/commands and exit 0
#
# Supported voice sessions run through Start Session or the installed
# relay-bridge skill/command. The old full-terminal direct mode lives only in
# services/voice_bridge.py for legacy manual debugging.
#
# Voice commands are written to /tmp/voice_cmd_ready for the agent to pick up,
# and TTS input is read from /tmp/tts_in.fifo.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# -- Paths --
# Read-only services bundled inside the .app (or repo, for dev): the
# Python source files and requirements.txt that ship with each release.
SERVICES_BUNDLE="$PROJECT_ROOT/services"
# Writable runtime data — venv + downloaded Python live here so the
# install path works for non-admin users with no Homebrew or system
# Python. Admin is required to install Homebrew or run macOS package
# installers, but ~/Library is always user-writable.
USER_DATA_DIR="$HOME/Library/Application Support/relay-runner"
SERVICES_DIR="$USER_DATA_DIR/services"
RELOCATABLE_PYTHON_DIR="$USER_DATA_DIR/python"
RELOCATABLE_PYTHON="$RELOCATABLE_PYTHON_DIR/bin/python3"
mkdir -p "$SERVICES_DIR"
VOICE_FIFO="/tmp/voice_in.fifo"
BRIDGE_SOCK="/tmp/voice_bridge.sock"
BRIDGE_STOP_REQUESTED_FILE="/tmp/voice_bridge_stop_requested"
# Records the cwd of whoever launched the bridge so the menu-bar app can
# classify the active session as either a workspace root or a project repo.
# Single-project repos get .orchestrator/config.toml initialized on
# activation if needed; workspace roots do not get a parent board.
BRIDGE_CWD_FILE="/tmp/voice_bridge.cwd"
BRIDGE_PROVIDER_FILE="/tmp/voice_bridge.provider"
BRIDGE_RUNTIME_FILES=(
    "$VOICE_FIFO"
    "$BRIDGE_SOCK"
    "/tmp/voice_cmd_ready"
    "/tmp/voice_cmd_ready.meta"
    "/tmp/voice_command_state.json"
    "/tmp/voice_cmd_claimed.json"
    "/tmp/tts_in.fifo"
    "/tmp/tts_control.sock"
    "/tmp/voice_bridge_heartbeat"
    "/tmp/voice_bridge_heartbeat.pid"
    "$BRIDGE_CWD_FILE"
    "$BRIDGE_PROVIDER_FILE"
    "/tmp/relay_board_now.txt"
    "/tmp/relay_board_prev.txt"
)

CONFIG_DIR="${XDG_CONFIG_HOME:-}"
if [ -z "$CONFIG_DIR" ]; then
    if [ "$(uname)" = "Darwin" ]; then
        CONFIG_DIR="$HOME/Library/Application Support"
    else
        CONFIG_DIR="$HOME/.config"
    fi
fi
CONFIG_PATH="$CONFIG_DIR/relay-runner/config.toml"

# Export PROJECT_ROOT so the slash command can find us
export PROJECT_ROOT
export PYTHONDONTWRITEBYTECODE=1

# -- Parse our own flags before passing the rest to voice_bridge.py --
# --venv-only: run only the venv bootstrap below, then exit. Used by
# the app's onboarding flow so it can call into the same battle-tested
# Python setup that interactive /relay-bridge sessions use, with output
# streamed back to the SwiftUI progress view.
# --install-skills: write Relay Runner command/skill files for Claude Code
# and Codex, then exit. Used by Settings → Install Skill so the template
# content lives here as a single source of truth instead of being duplicated
# as Swift literals.
VENV_ONLY=false
INSTALL_SKILLS_ONLY=false
ROTATE_LOG_ONLY=false

# Emit a progress marker the SwiftUI installer can parse to drive a
# determinate progress bar. Format: `RELAY_PROGRESS:<percent>:<label>`.
# Percent is 0–100, label is a short human-readable description of the
# current phase. Interactive callers see the same line as plain output;
# the SwiftUI side strips the `RELAY_PROGRESS:` prefix and treats the
# rest as structured. Keep labels short — they show up under a progress
# bar with limited horizontal space.
#
# Writes to stderr so it doesn't contaminate functions whose stdout
# the caller captures (e.g. `find_python`, `ensure_relocatable_python`).
# The SwiftUI parser merges stdout + stderr into one pipe, so it still
# sees these lines.
emit_progress() {
    echo "RELAY_PROGRESS:$1:$2" >&2
}

cleanup_bridge_runtime_files() {
    if [ -f /tmp/voice_bridge_heartbeat.pid ]; then
        kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null || true
    fi
    rm -f "${BRIDGE_RUNTIME_FILES[@]}"
}

ensure_fifo() {
    local path="$1"
    if [ -e "$path" ] && [ ! -p "$path" ]; then
        rm -f "$path"
    fi
    [ -p "$path" ] || mkfifo "$path" 2>/dev/null || true
}

voice_bridge_log_path() {
    echo "${VOICE_BRIDGE_LOG_PATH:-/tmp/voice_bridge.log}"
}

voice_bridge_log_stamp() {
    if [ -n "${VOICE_BRIDGE_LOG_TIMESTAMP:-}" ]; then
        echo "$VOICE_BRIDGE_LOG_TIMESTAMP"
    else
        date -u '+%Y%m%d-%H%M%S'
    fi
}

rotate_voice_bridge_log() {
    local log_path
    log_path="$(voice_bridge_log_path)"
    local reason="${VOICE_BRIDGE_LOG_REASON:-startup}"
    local provider="${VOICE_BRIDGE_LOG_PROVIDER:-${RELAY_RUNNER_PROVIDER:-unknown}}"
    local cwd="${VOICE_BRIDGE_LOG_CWD:-$PWD}"
    local previous="none"
    local log_dir log_name stem ext stamp candidate i

    log_dir="$(dirname "$log_path")"
    log_name="$(basename "$log_path")"
    stem="${log_name%.*}"
    if [ "$stem" = "$log_name" ]; then
        ext=".log"
    else
        ext=".${log_name##*.}"
    fi
    mkdir -p "$log_dir"

    if [ -s "$log_path" ]; then
        stamp="$(voice_bridge_log_stamp)"
        candidate="$log_dir/$stem.$stamp$ext"
        i=1
        while [ -e "$candidate" ]; do
            candidate="$log_dir/$stem.$stamp.$i$ext"
            i=$((i + 1))
        done
        if mv "$log_path" "$candidate"; then
            previous="$candidate"
        else
            previous="move_failed:$candidate"
        fi
    fi

    : > "$log_path"
    {
        echo "[relay-bridge] diagnostic log started at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
        echo "[relay-bridge] previous_log=$previous reason=$reason provider=$provider cwd=$cwd"
    } >> "$log_path"
}

# Write Relay Runner command/skill files into ~/.claude/commands and
# ~/.codex/skills. Mode "if-missing" (default) only writes a file if it
# doesn't already exist, so the bootstrap path can't silently clobber a user's
# local edits. Mode "force" always overwrites — used by the explicit
# Settings → Reinstall action.
#
# The bridge skill embeds the absolute path to *this* script so the agent can
# launch the relay daemon directly. Using $SCRIPT_DIR (rather than $PATH) keeps
# the skill working when the user's shell profile doesn't surface the bundled
# relay-bridge.
install_skills() {
    local mode="${1:-if-missing}"
    local cmds_dir="$HOME/.claude/commands"
    local bridge_md="$cmds_dir/relay-bridge.md"
    local stop_md="$cmds_dir/relay-stop.md"
    local legacy_pm_sync_md="$cmds_dir/pm-sync.md"
    local codex_skills_dir="$HOME/.codex/skills"
    local codex_bridge_dir="$codex_skills_dir/relay-bridge"
    local codex_stop_dir="$codex_skills_dir/relay-stop"
    local legacy_codex_pm_sync_dir="$codex_skills_dir/pm-sync"
    local codex_bridge_md="$codex_bridge_dir/SKILL.md"
    local codex_stop_md="$codex_stop_dir/SKILL.md"
    local relay_bridge_path="$SCRIPT_DIR/relay-bridge"

    mkdir -p "$cmds_dir"
    mkdir -p "$codex_bridge_dir" "$codex_stop_dir"

    # Reinstalls should scrub legacy Program Manager command/skill launchers
    # without touching user-owned .pm project data.
    rm -f "$legacy_pm_sync_md"
    rm -rf "$legacy_codex_pm_sync_dir"

    if [ "$mode" = "force" ] || [ ! -f "$bridge_md" ]; then
        # Quoted heredoc — no $-expansion. The single placeholder
        # __RELAY_BRIDGE__ gets sed-substituted below so the path lands
        # in the .md verbatim.
        cat > "$bridge_md" <<'BRIDGE_MD_EOF'
Connect voice I/O to this Claude session. You become a voice-interactive assistant: listen for spoken input, respond, and speak the response aloud via TTS.

## Setup

1. Verify the Relay Runner app is running:

```bash
pgrep -f 'relay-runner' > /dev/null 2>&1 && echo "app: ok" || echo "app: NOT RUNNING"
```

If not running, tell the user to start the Relay Runner menu bar app, then try `/relay-bridge` again. Do not proceed.

2. Kill any existing voice bridge and start a new one in relay mode. The bundled `relay-bridge` script handles its own venv install (relocatable Python, pip deps, Kokoro speech model) and short-circuits when everything's already set up; on first run it may take a couple of minutes downloading deps:

```bash
RELAY_CWD=$(pwd)
launchctl remove com.relay.voicebridge 2>/dev/null || true
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null || true
rm -f /tmp/voice_bridge_stop_requested
pkill -f '[v]oice_bridge.py' 2>/dev/null; rm -f /tmp/voice_in.fifo /tmp/voice_bridge.sock /tmp/voice_cmd_ready /tmp/voice_cmd_ready.meta /tmp/voice_command_state.json /tmp/voice_cmd_claimed.json /tmp/tts_in.fifo /tmp/tts_control.sock /tmp/voice_bridge_heartbeat /tmp/voice_bridge_heartbeat.pid /tmp/voice_bridge.cwd /tmp/voice_bridge.provider /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
RELAY_BRIDGE='__RELAY_BRIDGE__'
RELAY_PROVIDER=claude
VOICE_BRIDGE_LOG=/tmp/voice_bridge.log
VOICE_BRIDGE_LOG_REASON=start VOICE_BRIDGE_LOG_PROVIDER="$RELAY_PROVIDER" VOICE_BRIDGE_LOG_CWD="$RELAY_CWD" "$RELAY_BRIDGE" --rotate-log
launch_relay_bridge() {
    echo "[relay-bridge] launching via launchctl provider=$RELAY_PROVIDER cwd=$RELAY_CWD bridge=$RELAY_BRIDGE" >> "$VOICE_BRIDGE_LOG"
    launchctl submit -l com.relay.voicebridge -- /bin/bash -lc 'cd "$1" || exit 1; export RELAY_RUNNER_PROVIDER="$3"; "$2" --relay >> "$4" 2>&1; status=$?; echo "[relay-bridge] launchctl bridge process exited status=$status at $(date -u "+%Y-%m-%dT%H:%M:%SZ") provider=$3" >> "$4"; exit "$status"' relay-voice "$RELAY_CWD" "$RELAY_BRIDGE" "$RELAY_PROVIDER" "$VOICE_BRIDGE_LOG" >> "$VOICE_BRIDGE_LOG" 2>&1
    submit_status=$?
    echo "[relay-bridge] launchctl submit exit_status=$submit_status provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    for i in $(seq 1 20); do
        if [ -S /tmp/voice_bridge.sock ]; then
            echo "[relay-bridge] launchctl produced socket after ${i} checks provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
            return 0
        fi
        launchctl print "gui/$(id -u)/com.relay.voicebridge" >/dev/null 2>&1 || break
        sleep 0.5
    done
    if [ -S /tmp/voice_bridge.sock ]; then
        echo "[relay-bridge] launchctl produced socket provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
        return 0
    fi
    echo "[relay-bridge] launchctl did not produce a socket; submit_status=$submit_status uid=$(id -u) provider=$RELAY_PROVIDER cwd=$RELAY_CWD; launchctl print follows." >> "$VOICE_BRIDGE_LOG"
    launchctl print "gui/$(id -u)/com.relay.voicebridge" >> "$VOICE_BRIDGE_LOG" 2>&1
    print_status=$?
    [ "$print_status" -eq 0 ] || echo "[relay-bridge] launchctl print exit_status=$print_status" >> "$VOICE_BRIDGE_LOG"
    echo "[relay-bridge] falling back to direct background launch." >> "$VOICE_BRIDGE_LOG"
    launchctl remove com.relay.voicebridge 2>/dev/null || true
    nohup /bin/bash -lc 'cd "$1" || exit 1; export RELAY_RUNNER_PROVIDER="$3"; "$2" --relay >> "$4" 2>&1; status=$?; echo "[relay-bridge] direct bridge process exited status=$status at $(date -u "+%Y-%m-%dT%H:%M:%SZ") provider=$3" >> "$4"; exit "$status"' relay-direct "$RELAY_CWD" "$RELAY_BRIDGE" "$RELAY_PROVIDER" "$VOICE_BRIDGE_LOG" >> "$VOICE_BRIDGE_LOG" 2>&1 &
    fallback_pid=$!
    echo "[relay-bridge] direct fallback launched pid=$fallback_pid provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    for i in $(seq 1 20); do
        if [ -S /tmp/voice_bridge.sock ]; then
            echo "[relay-bridge] direct fallback produced socket after ${i} checks provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
            return 0
        fi
        sleep 0.5
    done
    echo "[relay-bridge] direct fallback did not produce a socket provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    return 1
}
launch_relay_bridge
```

3. Wait for the relay bridge to come up. The 60-iteration cap is generous on purpose: the very first invocation may need to download a Python interpreter (~18 MB) and the Kokoro speech model (~350 MB) before the bridge can listen, so allow ~30 seconds:

```bash
for i in $(seq 1 60); do [ -S /tmp/voice_bridge.sock ] && echo "bridge: ok" && break; sleep 0.5; done; [ -S /tmp/voice_bridge.sock ] || echo "bridge: FAILED"
```

If the bridge failed to start, tell the user to check `/tmp/voice_bridge.log` and stop here.

4. Once the bridge is up, speak a one-time startup confirmation:

```bash
if [ -p /tmp/tts_in.fifo ]; then printf '%s\n' 'Voice bridge is ready. You can speak at any point.' > /tmp/tts_in.fifo; fi
```

## Voice Interaction Loop

Now enter a continuous loop. Repeat these steps until the user says "stop listening" or you receive `__INTERRUPT__`:

### Step 0: Scan the orchestrator board

Before every wait for input, snapshot the active project's `.orchestrator/` directory and diff against the previous snapshot. You are the orchestrator — you should know what's on the board at all times, not wait to be told. Changes you should detect: tickets newly in `ready`, runs that transitioned `in_progress` → `done` (worker finished), backlog items the daemon auto-promoted to ready (dependency progression), cancellations, brand-new tickets in any column.

```bash
{
    if [ -d .orchestrator ]; then
        for f in .orchestrator/*.md; do
            [ -f "$f" ] || continue
            awk -v fn="$(basename "$f")" '
                BEGIN { id=""; title=""; status="" }
                /^---$/ { n++; next }
                n==1 && /^id:/    { sub(/^id:[ \t]*/,"");    id    = $0 }
                n==1 && /^title:/ { sub(/^title:[ \t]*/,""); title = $0 }
                n==1 && /^status:/{ sub(/^status:[ \t]*/,""); status = $0 }
                END { if (id != "") print id " [" status "] " title }
            ' "$f"
        done | sort
    fi
} > /tmp/relay_board_now.txt
if [ -f /tmp/relay_board_prev.txt ]; then
    BOARD_DIFF=$(diff /tmp/relay_board_prev.txt /tmp/relay_board_now.txt)
    if [ -n "$BOARD_DIFF" ]; then
        echo "__BOARD_CHANGES__"
        echo "$BOARD_DIFF"
        echo "__END_BOARD_CHANGES__"
    fi
fi
cp /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
```

If `__BOARD_CHANGES__` appears in the output, **remember the change set** — you'll surface it organically as part of your next response (either as a brief preface to whatever the user said, or as the response itself if the change is the meaningful event). Examples of good surfacing:
- *"R R seven just finished — want me to merge it?"* (new `done`)
- *"R R eight just landed in ready and the worker is on it."* (new `ready` with active run)
- *"R R nine moved to ready automatically because R R seven completed."* (dep-progression)

Do **not** announce changes that are just consequences of an action the user explicitly took *this turn* (e.g., they said "dispatch R R nine" — don't then read it back to them). Use judgment: announce ambient changes; stay quiet about your own work.

### Step 1: Wait for voice input

```bash
while [ ! -f /tmp/voice_cmd_ready ]; do
    sleep 0.2
    touch /tmp/voice_bridge_heartbeat
    [ -S /tmp/voice_bridge.sock ] || { echo "__BRIDGE_DIED__"; exit 0; }
done
cmd_tmp=$(mktemp /tmp/voice_cmd_claim.XXXXXX) || exit 1
meta_tmp="$cmd_tmp.meta"
if mv /tmp/voice_cmd_ready "$cmd_tmp" 2>/dev/null; then
    if [ -f /tmp/voice_cmd_ready.meta ] && mv /tmp/voice_cmd_ready.meta "$meta_tmp" 2>/dev/null; then
        cp "$meta_tmp" /tmp/voice_cmd_claimed.json
    fi
    cat "$cmd_tmp"
    rm -f "$cmd_tmp" "$meta_tmp"
else
    rm -f "$cmd_tmp" "$meta_tmp"
    exit 0
fi
(while sleep 2; do touch /tmp/voice_bridge_heartbeat; done) & echo $! > /tmp/voice_bridge_heartbeat.pid
```

This blocks until the user speaks via Caps Lock. If the voice bridge is killed (e.g. a new session was started), the loop exits. Once a command is read, a background heartbeat refresher is spawned so the app's watchdog doesn't reap the bridge during long Claude processing (multi-tool tasks, builds, agent spawns). The refresher is torn down in Step 3.

### Step 1.5: Preemption checkpoints

Relay messages are live steering input, not a serial queue. Newest intent wins for future work. Before starting each new shell command, MCP call, or high-stakes/irreversible action, and again before writing TTS, check whether a newer Relay message is waiting:

```bash
cmd_tmp=$(mktemp /tmp/voice_cmd_claim.XXXXXX) || exit 1
meta_tmp="$cmd_tmp.meta"
if [ -f /tmp/voice_cmd_ready ] && mv /tmp/voice_cmd_ready "$cmd_tmp" 2>/dev/null; then
    if [ -f /tmp/voice_cmd_ready.meta ] && mv /tmp/voice_cmd_ready.meta "$meta_tmp" 2>/dev/null; then
        cp "$meta_tmp" /tmp/voice_cmd_claimed.json
    fi
    cat "$cmd_tmp"
    rm -f "$cmd_tmp" "$meta_tmp"
else
    rm -f "$cmd_tmp" "$meta_tmp"
fi
```

If the checkpoint prints a normal user message, stop following the stale request and handle the new message as the active instruction. If it prints `__INTERRUPT__`, silently return to waiting. Do not start new high-stakes or irreversible actions from stale instructions after a newer message arrives. If an action already completed, report that honestly when responding to the newest message.

Already-running shell commands and MCP calls cannot be forcibly preempted by the bridge. Let them return, interrupt them only when the user explicitly canceled, then run this checkpoint before any follow-up action. Codex and Claude use the same cooperative preemption contract; no provider-specific hard cancellation is assumed.

Each claimed command copies `/tmp/voice_cmd_ready.meta` to `/tmp/voice_cmd_claimed.json`. Treat that seq/id as the authority for any ticket edit, ticket creation, dispatch, or TTS response from this command. Relay-orchestrator dispatches carry that metadata and the daemon rejects them if `/tmp/voice_command_state.json` names a newer command.

### Step 2: Process the input

- If the text is `__BRIDGE_DIED__`, the voice session was ended (another session was started, or the bridge was stopped). Say "Voice session ended." and stop the loop — do NOT go back to Step 1. Clean up and return to normal operation.
- If the text is `__INTERRUPT__`, **silently** go back to Step 1. Do NOT generate any text response, do NOT write to `/tmp/tts_in.fifo`, do NOT acknowledge in any user-visible way. Cancel means the user wants silence — speaking again would just give them another message to cancel, which loops.
- Otherwise, resolve the text as a Relay command action before doing work. Codex and Claude follow the same command-action contract:
  - Internal controls (`__TTS_STOP__`, `__PLAY__`, `__REPLAY__`, `__INTERRUPT__`, `__CANCEL__`) are deliberate no-ticket actions.
  - Repo/project work must resolve the target project and create/refine a visible ticket only after the raw command has been classified into actionable work.
  - Existing ticket commands may edit/refine the ticket or dispatch a ready worker.
  - The foreground session is the orchestrator; do not perform substantive implementation directly unless the user explicitly asks to keep the work inline.
  - Your response must name the action outcome, such as created ticket, edited ticket, dispatched worker, waiting on refined ticket content, or waiting on a target-project choice.

### Step 2.5: Send working progress to the notch

When you write a non-final progress update in the terminal during a long task, also mirror that exact short status to Relay Runner. These updates appear as the working-state notch label when no more specific compact activity label is active. Existing compact labels such as Listening, Response ready, worker state, bridge recovery, or ticket activity take priority over this stream.

```bash
python3 - <<'PY'
import json
import socket

text = "YOUR_PROGRESS_UPDATE"
if text.strip():
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        sock.sendto(
            json.dumps({
                "source": "bridge",
                "state": "working",
                "text": text.strip(),
            }).encode(),
            "/tmp/voice_state.sock",
        )
    except OSError:
        pass
    finally:
        sock.close()
PY
```

### Step 3: Speak your response

After generating your response, tear down the background heartbeat refresher spawned in Step 1, then ensure the bridge session metadata remains intact. The Relay Runner app owns daemon recovery; if the daemon is missing here, preserve `/tmp/voice_bridge.cwd` and `/tmp/voice_bridge.provider`, wait briefly for the app watchdog, and skip TTS rather than deleting runtime context from the agent side:

```bash
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null; rm -f /tmp/voice_bridge_heartbeat.pid
touch /tmp/voice_bridge_heartbeat
if [ -f /tmp/voice_bridge_stop_requested ]; then
    exit 0
fi
if ! pgrep -f '[v]oice_bridge.py' > /dev/null 2>&1; then
    if [ -f /tmp/voice_bridge_stop_requested ]; then
        exit 0
    fi
    VOICE_BRIDGE_LOG=/tmp/voice_bridge.log
    RELAY_CWD="$(cat /tmp/voice_bridge.cwd 2>/dev/null || pwd)"
    RELAY_PROVIDER="$(cat /tmp/voice_bridge.provider 2>/dev/null || echo claude)"
    echo "[relay-bridge] bridge daemon missing after response; preserving session metadata for app watchdog recovery provider=${RELAY_PROVIDER:-none} cwd=$RELAY_CWD" >> "$VOICE_BRIDGE_LOG"
    for i in $(seq 1 20); do
        if [ -f /tmp/voice_bridge_stop_requested ]; then
            exit 0
        fi
        if pgrep -f '[v]oice_bridge.py' > /dev/null 2>&1; then
            break
        fi
        sleep 0.5
    done
fi
```

Then send the TTS response with the claimed Relay command metadata. Keep it concise and conversational (strip markdown formatting, code blocks, and verbose explanations — speak the key points). Use a nonblocking FIFO open so a missing/recovering bridge cannot hang the final-response cleanup:

```bash
python3 - <<'PY'
import errno
import json
import os
from pathlib import Path

payload = {"text": "YOUR_SPOKEN_RESPONSE"}
claim_path = Path("/tmp/voice_cmd_claimed.json")
if claim_path.is_file():
    try:
        claim = json.loads(claim_path.read_text())
        for key in ("relay_command_seq", "relay_command_id"):
            if key in claim:
                payload[key] = claim[key]
    except (OSError, json.JSONDecodeError):
        pass
try:
    fd = os.open("/tmp/tts_in.fifo", os.O_WRONLY | os.O_NONBLOCK)
except OSError as exc:
    if exc.errno in (errno.ENOENT, errno.ENXIO):
        raise SystemExit(0)
    raise
with os.fdopen(fd, "w") as fifo:
    print(json.dumps(payload), file=fifo)
PY
```

Important: Run the preemption checkpoint immediately before this write. If a newer Relay message is waiting, do not write stale TTS; handle the newer message instead. Only send the spoken summary, not the full detailed response.

### Step 4: Loop

Go back to Step 1 and wait for the next voice command.

## Cleanup

When the session ends (user says "stop listening", "exit voice", or similar), clean up:

```bash
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null; rm -f /tmp/voice_bridge_heartbeat.pid
launchctl remove com.relay.voicebridge 2>/dev/null || true
: > /tmp/voice_bridge_stop_requested
pkill -f '[v]oice_bridge.py' 2>/dev/null; rm -f /tmp/voice_in.fifo /tmp/voice_bridge.sock /tmp/voice_cmd_ready /tmp/voice_cmd_ready.meta /tmp/voice_command_state.json /tmp/voice_cmd_claimed.json /tmp/tts_in.fifo /tmp/tts_control.sock /tmp/voice_bridge_heartbeat /tmp/voice_bridge_heartbeat.pid /tmp/voice_bridge.cwd /tmp/voice_bridge.provider /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
```

## Important Notes

- You are in a normal Claude session with full tool access. Voice input is just another way for the user to send messages.
- Speak concisely. TTS responses should be 1-3 sentences summarizing what you did or what you found. The user can read the full detail in the conversation.
- If the user asks you to run commands, edit files, or do project work, first resolve the command action above. Do the implementation inline only when the command explicitly asks for inline work.
- The relay daemon handles Caps Lock detection, STT, and TTS playback. You just read commands and write responses.
BRIDGE_MD_EOF
        # Substitute the relay-bridge absolute path. Use | as the sed
        # delimiter so / in $relay_bridge_path doesn't conflict.
        # In-place edit via tmp file (BSD/macOS sed -i takes a backup
        # suffix arg, GNU doesn't — round-trip via mv is portable).
        local tmp="$bridge_md.tmp"
        sed "s|__RELAY_BRIDGE__|$relay_bridge_path|g" "$bridge_md" > "$tmp" && mv "$tmp" "$bridge_md"
    fi

    if [ "$mode" = "force" ] || [ ! -f "$stop_md" ]; then
        cat > "$stop_md" <<'STOP_MD_EOF'
Stop the voice I/O bridge for this Claude session. Use this to end a `/relay-bridge` voice session cleanly without exiting Claude Code.

## Steps

1. Kill the voice bridge process and remove its runtime files:

```bash
launchctl remove com.relay.voicebridge 2>/dev/null || true
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null || true
: > /tmp/voice_bridge_stop_requested
pkill -f '[v]oice_bridge.py' 2>/dev/null; rm -f /tmp/voice_in.fifo /tmp/voice_bridge.sock /tmp/voice_cmd_ready /tmp/voice_cmd_ready.meta /tmp/voice_command_state.json /tmp/voice_cmd_claimed.json /tmp/tts_in.fifo /tmp/tts_control.sock /tmp/voice_bridge_heartbeat /tmp/voice_bridge_heartbeat.pid /tmp/voice_bridge.cwd /tmp/voice_bridge.provider /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
```

2. Confirm it's stopped:

```bash
pgrep -f '[v]oice_bridge.py' > /dev/null 2>&1 && echo "bridge: STILL RUNNING" || echo "bridge: stopped"
```

If the bridge is still running, tell the user to check `/tmp/voice_bridge.log` and try again. Otherwise, tell the user the voice session has ended.

## Notes

- This only stops the voice bridge. The Relay Runner menu bar app keeps running.
- Any active `/relay-bridge` voice loop in another Claude session will detect the dead socket on its next heartbeat and exit on its own.
- To start voice again, run `/relay-bridge`.
STOP_MD_EOF
    fi

    if [ "$mode" = "force" ] || [ ! -f "$codex_bridge_md" ]; then
        cat > "$codex_bridge_md" <<'CODEX_BRIDGE_MD_EOF'
---
name: relay-bridge
description: Connect voice I/O to this Codex session. Use when the user wants a Relay Runner voice session, says to start listening, or launches Codex from Relay Runner.
---

# relay-bridge

Connect voice I/O to this Codex session. You become a voice-interactive assistant: listen for spoken input, respond normally in the terminal, and write a concise spoken summary to Relay Runner TTS.

## Setup

1. Verify the Relay Runner app is running:

```bash
pgrep -f 'relay-runner' > /dev/null 2>&1 && echo "app: ok" || echo "app: NOT RUNNING"
```

If not running, tell the user to start the Relay Runner menu bar app, then stop.

2. Kill any existing voice bridge and start a new one in relay mode:

```bash
launchctl remove com.relay.voicebridge 2>/dev/null || true
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null || true
rm -f /tmp/voice_bridge_stop_requested
pkill -f '[v]oice_bridge.py' 2>/dev/null; rm -f /tmp/voice_in.fifo /tmp/voice_bridge.sock /tmp/voice_cmd_ready /tmp/voice_cmd_ready.meta /tmp/voice_command_state.json /tmp/voice_cmd_claimed.json /tmp/tts_in.fifo /tmp/tts_control.sock /tmp/voice_bridge_heartbeat /tmp/voice_bridge_heartbeat.pid /tmp/voice_bridge.cwd /tmp/voice_bridge.provider /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
RELAY_CWD=$(pwd)
RELAY_BRIDGE='__RELAY_BRIDGE__'
RELAY_PROVIDER=codex
VOICE_BRIDGE_LOG=/tmp/voice_bridge.log
VOICE_BRIDGE_LOG_REASON=start VOICE_BRIDGE_LOG_PROVIDER="$RELAY_PROVIDER" VOICE_BRIDGE_LOG_CWD="$RELAY_CWD" "$RELAY_BRIDGE" --rotate-log
launch_relay_bridge() {
    echo "[relay-bridge] launching via launchctl provider=$RELAY_PROVIDER cwd=$RELAY_CWD bridge=$RELAY_BRIDGE" >> "$VOICE_BRIDGE_LOG"
    launchctl submit -l com.relay.voicebridge -- /bin/bash -lc 'cd "$1" || exit 1; export RELAY_RUNNER_PROVIDER="$3"; "$2" --relay >> "$4" 2>&1; status=$?; echo "[relay-bridge] launchctl bridge process exited status=$status at $(date -u "+%Y-%m-%dT%H:%M:%SZ") provider=$3" >> "$4"; exit "$status"' relay-voice "$RELAY_CWD" "$RELAY_BRIDGE" "$RELAY_PROVIDER" "$VOICE_BRIDGE_LOG" >> "$VOICE_BRIDGE_LOG" 2>&1
    submit_status=$?
    echo "[relay-bridge] launchctl submit exit_status=$submit_status provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    for i in $(seq 1 20); do
        if [ -S /tmp/voice_bridge.sock ]; then
            echo "[relay-bridge] launchctl produced socket after ${i} checks provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
            return 0
        fi
        launchctl print "gui/$(id -u)/com.relay.voicebridge" >/dev/null 2>&1 || break
        sleep 0.5
    done
    if [ -S /tmp/voice_bridge.sock ]; then
        echo "[relay-bridge] launchctl produced socket provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
        return 0
    fi
    echo "[relay-bridge] launchctl did not produce a socket; submit_status=$submit_status uid=$(id -u) provider=$RELAY_PROVIDER cwd=$RELAY_CWD; launchctl print follows." >> "$VOICE_BRIDGE_LOG"
    launchctl print "gui/$(id -u)/com.relay.voicebridge" >> "$VOICE_BRIDGE_LOG" 2>&1
    print_status=$?
    [ "$print_status" -eq 0 ] || echo "[relay-bridge] launchctl print exit_status=$print_status" >> "$VOICE_BRIDGE_LOG"
    echo "[relay-bridge] falling back to direct background launch." >> "$VOICE_BRIDGE_LOG"
    launchctl remove com.relay.voicebridge 2>/dev/null || true
    nohup /bin/bash -lc 'cd "$1" || exit 1; export RELAY_RUNNER_PROVIDER="$3"; "$2" --relay >> "$4" 2>&1; status=$?; echo "[relay-bridge] direct bridge process exited status=$status at $(date -u "+%Y-%m-%dT%H:%M:%SZ") provider=$3" >> "$4"; exit "$status"' relay-direct "$RELAY_CWD" "$RELAY_BRIDGE" "$RELAY_PROVIDER" "$VOICE_BRIDGE_LOG" >> "$VOICE_BRIDGE_LOG" 2>&1 &
    fallback_pid=$!
    echo "[relay-bridge] direct fallback launched pid=$fallback_pid provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    for i in $(seq 1 20); do
        if [ -S /tmp/voice_bridge.sock ]; then
            echo "[relay-bridge] direct fallback produced socket after ${i} checks provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
            return 0
        fi
        sleep 0.5
    done
    echo "[relay-bridge] direct fallback did not produce a socket provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    return 1
}
launch_relay_bridge
```

3. Wait for the bridge:

```bash
for i in $(seq 1 60); do [ -S /tmp/voice_bridge.sock ] && echo "bridge: ok" && break; sleep 0.5; done; [ -S /tmp/voice_bridge.sock ] || echo "bridge: FAILED"
```

If the bridge failed, tell the user to check `/tmp/voice_bridge.log` and stop.

4. Once the bridge is up, speak a one-time startup confirmation:

```bash
if [ -p /tmp/tts_in.fifo ]; then printf '%s\n' 'Voice bridge is ready. You can speak at any point.' > /tmp/tts_in.fifo; fi
```

## Voice Loop

Repeat until the user asks to stop listening or the bridge dies.

Before each wait, snapshot `.orchestrator/` if it exists and remember meaningful board changes:

```bash
{
    if [ -d .orchestrator ]; then
        for f in .orchestrator/*.md; do
            [ -f "$f" ] || continue
            awk '
                BEGIN { id=""; title=""; status="" }
                /^---$/ { n++; next }
                n==1 && /^id:/     { sub(/^id:[ \t]*/,"");     id = $0 }
                n==1 && /^title:/  { sub(/^title:[ \t]*/,"");  title = $0 }
                n==1 && /^status:/ { sub(/^status:[ \t]*/,""); status = $0 }
                END { if (id != "") print id " [" status "] " title }
            ' "$f"
        done | sort
    fi
} > /tmp/relay_board_now.txt
if [ -f /tmp/relay_board_prev.txt ]; then
    BOARD_DIFF=$(diff /tmp/relay_board_prev.txt /tmp/relay_board_now.txt)
    if [ -n "$BOARD_DIFF" ]; then
        echo "__BOARD_CHANGES__"
        echo "$BOARD_DIFF"
        echo "__END_BOARD_CHANGES__"
    fi
fi
cp /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
```

Wait for voice input:

```bash
while [ ! -f /tmp/voice_cmd_ready ]; do
    sleep 0.2
    touch /tmp/voice_bridge_heartbeat
    [ -S /tmp/voice_bridge.sock ] || { echo "__BRIDGE_DIED__"; exit 0; }
done
cmd_tmp=$(mktemp /tmp/voice_cmd_claim.XXXXXX) || exit 1
meta_tmp="$cmd_tmp.meta"
if mv /tmp/voice_cmd_ready "$cmd_tmp" 2>/dev/null; then
    if [ -f /tmp/voice_cmd_ready.meta ] && mv /tmp/voice_cmd_ready.meta "$meta_tmp" 2>/dev/null; then
        cp "$meta_tmp" /tmp/voice_cmd_claimed.json
    fi
    cat "$cmd_tmp"
    rm -f "$cmd_tmp" "$meta_tmp"
else
    rm -f "$cmd_tmp" "$meta_tmp"
    exit 0
fi
(while sleep 2; do touch /tmp/voice_bridge_heartbeat; done) & echo $! > /tmp/voice_bridge_heartbeat.pid
```

Preemption checkpoints:

Relay messages are live steering input, not a serial queue. Newest intent wins for future work. Before starting each new shell command, MCP call, or high-stakes/irreversible action, and again before writing TTS, check whether a newer Relay message is waiting:

```bash
cmd_tmp=$(mktemp /tmp/voice_cmd_claim.XXXXXX) || exit 1
meta_tmp="$cmd_tmp.meta"
if [ -f /tmp/voice_cmd_ready ] && mv /tmp/voice_cmd_ready "$cmd_tmp" 2>/dev/null; then
    if [ -f /tmp/voice_cmd_ready.meta ] && mv /tmp/voice_cmd_ready.meta "$meta_tmp" 2>/dev/null; then
        cp "$meta_tmp" /tmp/voice_cmd_claimed.json
    fi
    cat "$cmd_tmp"
    rm -f "$cmd_tmp" "$meta_tmp"
else
    rm -f "$cmd_tmp" "$meta_tmp"
fi
```

If the checkpoint prints a normal user message, stop following the stale request and handle the new message as the active instruction. If it prints `__INTERRUPT__`, silently return to waiting. Do not start new high-stakes or irreversible actions from stale instructions after a newer message arrives. If an action already completed, report that honestly when responding to the newest message.

Already-running shell commands and MCP calls cannot be forcibly preempted by the bridge. Let them return, interrupt them only when the user explicitly canceled, then run this checkpoint before any follow-up action. Codex and Claude use the same cooperative preemption contract; no provider-specific hard cancellation is assumed.

Each claimed command copies `/tmp/voice_cmd_ready.meta` to `/tmp/voice_cmd_claimed.json`. Treat that seq/id as the authority for any ticket edit, ticket creation, dispatch, or TTS response from this command. Relay-orchestrator dispatches carry that metadata and the daemon rejects them if `/tmp/voice_command_state.json` names a newer command.

Interpret the text:
- `__BRIDGE_DIED__`: say "Voice session ended." and stop.
- `__INTERRUPT__`: silently return to waiting. Do not respond or write TTS.
- Otherwise, resolve it as a Relay command action before doing work. Codex and Claude follow the same command-action contract:
  - Internal controls (`__TTS_STOP__`, `__PLAY__`, `__REPLAY__`, `__INTERRUPT__`, `__CANCEL__`) are deliberate no-ticket actions.
  - Repo/project work must resolve the target project and create/refine a visible ticket only after the raw command has been classified into actionable work.
  - Existing ticket commands may edit/refine the ticket or dispatch a ready worker.
  - The foreground session is the orchestrator; do not perform substantive implementation directly unless the user explicitly asks to keep the work inline.
  - Your response must name the action outcome, such as created ticket, edited ticket, dispatched worker, waiting on refined ticket content, or waiting on a target-project choice.

Send working progress to the notch:

When you write a non-final progress update in the terminal during a long task, also mirror that exact short status to Relay Runner. These updates appear as the working-state notch label when no more specific compact activity label is active. Existing compact labels such as Listening, Response ready, worker state, bridge recovery, or ticket activity take priority over this stream.

```bash
python3 - <<'PY'
import json
import socket

text = "YOUR_PROGRESS_UPDATE"
if text.strip():
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        sock.sendto(
            json.dumps({
                "source": "bridge",
                "state": "working",
                "text": text.strip(),
            }).encode(),
            "/tmp/voice_state.sock",
        )
    except OSError:
        pass
    finally:
        sock.close()
PY
```

After your response, stop the heartbeat refresher and ensure the bridge session metadata remains intact. The Relay Runner app owns daemon recovery; if the daemon is missing here, preserve `/tmp/voice_bridge.cwd` and `/tmp/voice_bridge.provider`, wait briefly for the app watchdog, and skip TTS rather than deleting runtime context from the agent side:

```bash
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null; rm -f /tmp/voice_bridge_heartbeat.pid
touch /tmp/voice_bridge_heartbeat
if [ -f /tmp/voice_bridge_stop_requested ]; then
    exit 0
fi
if ! pgrep -f '[v]oice_bridge.py' > /dev/null 2>&1; then
    if [ -f /tmp/voice_bridge_stop_requested ]; then
        exit 0
    fi
    VOICE_BRIDGE_LOG=/tmp/voice_bridge.log
    RELAY_CWD="$(cat /tmp/voice_bridge.cwd 2>/dev/null || pwd)"
    RELAY_PROVIDER="$(cat /tmp/voice_bridge.provider 2>/dev/null || echo codex)"
    echo "[relay-bridge] bridge daemon missing after response; preserving session metadata for app watchdog recovery provider=${RELAY_PROVIDER:-none} cwd=$RELAY_CWD" >> "$VOICE_BRIDGE_LOG"
    for i in $(seq 1 20); do
        if [ -f /tmp/voice_bridge_stop_requested ]; then
            exit 0
        fi
        if pgrep -f '[v]oice_bridge.py' > /dev/null 2>&1; then
            break
        fi
        sleep 0.5
    done
fi
```

Write only the spoken summary to TTS, tagged with the claimed Relay command metadata. Keep it to 1-3 conversational sentences and strip markdown/code details. Use a nonblocking FIFO open so a missing/recovering bridge cannot hang the final-response cleanup:

```bash
python3 - <<'PY'
import errno
import json
import os
from pathlib import Path

payload = {"text": "YOUR_SPOKEN_RESPONSE"}
claim_path = Path("/tmp/voice_cmd_claimed.json")
if claim_path.is_file():
    try:
        claim = json.loads(claim_path.read_text())
        for key in ("relay_command_seq", "relay_command_id"):
            if key in claim:
                payload[key] = claim[key]
    except (OSError, json.JSONDecodeError):
        pass
try:
    fd = os.open("/tmp/tts_in.fifo", os.O_WRONLY | os.O_NONBLOCK)
except OSError as exc:
    if exc.errno in (errno.ENOENT, errno.ENXIO):
        raise SystemExit(0)
    raise
with os.fdopen(fd, "w") as fifo:
    print(json.dumps(payload), file=fifo)
PY
```

Run the preemption checkpoint immediately before this write. If a newer Relay message is waiting, do not write stale TTS; handle the newer message instead. Then return to waiting.

## Cleanup

When the session ends:

```bash
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null; rm -f /tmp/voice_bridge_heartbeat.pid
launchctl remove com.relay.voicebridge 2>/dev/null || true
: > /tmp/voice_bridge_stop_requested
pkill -f '[v]oice_bridge.py' 2>/dev/null; rm -f /tmp/voice_in.fifo /tmp/voice_bridge.sock /tmp/voice_cmd_ready /tmp/voice_cmd_ready.meta /tmp/voice_command_state.json /tmp/voice_cmd_claimed.json /tmp/tts_in.fifo /tmp/tts_control.sock /tmp/voice_bridge_heartbeat /tmp/voice_bridge_heartbeat.pid /tmp/voice_bridge.cwd /tmp/voice_bridge.provider /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
```
