relay_command_hash() {
    shasum -a 256 < "$1" | awk '{print $1}'
}

recorded_command_hash() {
    [ -f "$RELAY_COMMAND_MANIFEST" ] || return 0
    awk -v path="$1" 'substr($0, 67) == path { hash = substr($0, 1, 64) } END { print hash }' \
        "$RELAY_COMMAND_MANIFEST"
}

# Record <hash> as what Relay last wrote to <path>; an empty hash forgets it.
record_command_hash() {
    local path="$1" hash="$2" tmp="$RELAY_COMMAND_MANIFEST.$$"
    mkdir -p "$(dirname "$RELAY_COMMAND_MANIFEST")"
    : > "$tmp"
    if [ -f "$RELAY_COMMAND_MANIFEST" ]; then
        awk -v path="$path" 'substr($0, 67) != path' "$RELAY_COMMAND_MANIFEST" > "$tmp"
    fi
    if [ -n "$hash" ]; then
        printf '%s  %s\n' "$hash" "$path" >> "$tmp"
    fi
    mv "$tmp" "$RELAY_COMMAND_MANIFEST"
}

legacy_relay_command() {
    # bash 3.2 ends a ${var//pattern/...} pattern at a literal "/" even inside
    # quotes, so each path must be a single expansion.
    local content hash
    local bridge_path="$SCRIPT_DIR/relay-bridge"
    local reply_helper_path="$SERVICES_BUNDLE/relay_reply.py"
    content="$(cat "$1")"
    content="${content//"$bridge_path"/__RELAY_BRIDGE__}"
    content="${content//"$reply_helper_path"/__RELAY_REPLY_HELPER__}"
    hash="$(printf '%s\n' "$content" | shasum -a 256 | cut -c1-16)"
    case "$LEGACY_RELAY_COMMAND_HASHES" in
        *" $hash"*) return 0 ;;
    esac
    return 1
}

# Move <staged> into <dest>. "force" always writes (Settings → Reinstall,
# after the user confirmed). "refresh" writes a missing file and replaces an
# existing one only while it is still exactly what Relay installed: its hash
# matches the recorded one or, for installs that predate the record, a shipped
# version. Anything else is a user edit and is kept.
install_relay_command() {
    local mode="$1" staged="$2" dest="$3"
    local new_hash current_hash recorded
    new_hash="$(relay_command_hash "$staged")"
    if [ "$mode" != "force" ] && [ -f "$dest" ]; then
        current_hash="$(relay_command_hash "$dest")"
        recorded="$(recorded_command_hash "$dest")"
        if [ "$current_hash" = "$new_hash" ]; then
            rm -f "$staged"
            record_command_hash "$dest" "$new_hash"
            return 0
        fi
        if [ "$current_hash" != "$recorded" ] \
           && { [ -n "$recorded" ] || ! legacy_relay_command "$dest"; }; then
            rm -f "$staged"
            echo "[relay-bridge] Kept your edited $dest. Settings → Relay Skills → Reinstall replaces it with the current version." >&2
            return 0
        fi
    fi
    mv "$staged" "$dest"
    record_command_hash "$dest" "$new_hash"
}

# Remove <path> only if the record shows Relay installed it and it is
# unmodified; otherwise it belongs to the user.
remove_relay_command() {
    local path="$1" recorded
    [ -f "$path" ] || return 0
    recorded="$(recorded_command_hash "$path")"
    if [ -n "$recorded" ] && [ "$(relay_command_hash "$path")" = "$recorded" ]; then
        rm -f "$path"
        record_command_hash "$path" ""
    fi
}

# Write Relay Runner command/skill files into ~/.claude/commands and
# ~/.codex/skills. Mode "refresh" (default) installs missing files and brings
# unmodified Relay installs up to the shipped version while keeping user
# edits; it runs on every Start Session, so an app upgrade takes effect on the
# next launch. Mode "force" always overwrites — used by the explicit
# Settings → Reinstall action.
#
# The bridge skill embeds the absolute path to *this* script so the agent can
# launch the relay daemon directly. Using $SCRIPT_DIR (rather than $PATH) keeps
# the skill working when the user's shell profile doesn't surface the bundled
# relay-bridge.
install_skills() {
    local mode="${1:-refresh}"
    local cmds_dir="$HOME/.claude/commands"
    local bridge_md="$cmds_dir/relay-bridge.md"
    local stop_md="$cmds_dir/relay-stop.md"
    local dispatch_md="$cmds_dir/relay-dispatch.md"
    local workflow_md="$cmds_dir/relay-workflow.md"
    local legacy_link_md="$cmds_dir/relay-link-project.md"
    local legacy_orchestrate_md="$cmds_dir/relay-orchestrate.md"
    local legacy_pm_sync_md="$cmds_dir/pm-sync.md"
    local codex_skills_dir="$HOME/.codex/skills"
    local codex_bridge_dir="$codex_skills_dir/relay-bridge"
    local codex_stop_dir="$codex_skills_dir/relay-stop"
    local codex_dispatch_dir="$codex_skills_dir/relay-dispatch"
    local codex_workflow_dir="$codex_skills_dir/relay-workflow"
    local legacy_codex_pm_sync_dir="$codex_skills_dir/pm-sync"
    local codex_bridge_md="$codex_bridge_dir/SKILL.md"
    local codex_stop_md="$codex_stop_dir/SKILL.md"
    local codex_dispatch_md="$codex_dispatch_dir/SKILL.md"
    local codex_workflow_md="$codex_workflow_dir/SKILL.md"
    local relay_bridge_path="$SCRIPT_DIR/relay-bridge"
    local relay_reply_helper_path="$SERVICES_BUNDLE/relay_reply.py"
    local staged

    mkdir -p "$cmds_dir"
    mkdir -p "$codex_bridge_dir" "$codex_stop_dir" "$codex_dispatch_dir" "$codex_workflow_dir"

    # Relay-named launchers from earlier releases (the project-linking flow
    # and the relay-orchestrate → relay-dispatch rename) could carry Linear
    # instructions, so they are always removed. Legacy Program Manager
    # pm-sync launchers go only when Relay's record shows it installed them
    # unmodified; user-owned pm-sync skills and .pm project data stay.
    rm -f "$legacy_link_md" "$legacy_orchestrate_md"
    remove_relay_command "$legacy_pm_sync_md"
    remove_relay_command "$legacy_codex_pm_sync_dir/SKILL.md"
    rmdir "$legacy_codex_pm_sync_dir" 2>/dev/null || true

    # Quoted heredocs — no $-expansion. Bridge path placeholders get
    # sed-substituted after staging so they land in the .md verbatim.
    staged="$bridge_md.relay-new"
    cat > "$staged" <<'BRIDGE_MD_EOF'
Connect voice I/O to this Claude session when invoked manually. Relay Runner's menu-bar Start Session path owns a nonblocking app-managed transport instead of running this foreground loop.

## Setup

If `${RELAY_RUNNER_APP_SESSION:-0}` is `1`, the menu-bar Start Session path already owns bridge startup, heartbeat, and PTY delivery. Do not run this command unless the user explicitly asked to replace that app-managed session with a manual `/relay-bridge` loop.

1. Verify the Relay Runner app is running:

```bash
if [ "${RELAY_RUNNER_APP_SESSION:-0}" = "1" ] || pgrep -f 'relay-runner' > /dev/null 2>&1; then echo "app: ok"; else echo "app: NOT RUNNING"; fi
```

If not running, tell the user to start the Relay Runner menu bar app, then try `/relay-bridge` again. Do not proceed.

2. Kill any existing voice bridge and start a new one in relay mode. The bundled `relay-bridge` script handles its own venv install (relocatable Python, pip deps, Kokoro speech model) and short-circuits when everything's already set up; on first run it may take a couple of minutes downloading deps:

```bash
RELAY_CWD=$(pwd)
launchctl remove com.relay.voicebridge 2>/dev/null || true
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null || true
rm -f /tmp/voice_bridge_stop_requested
pkill -f '[v]oice_bridge.py' 2>/dev/null; rm -f /tmp/voice_in.fifo /tmp/voice_bridge.sock /tmp/voice_cmd_ready /tmp/voice_cmd_ready.meta /tmp/voice_command_state.json /tmp/voice_cmd_claimed.json /tmp/voice_cmd_manual_ack.json /tmp/voice_command_authorizations.json /tmp/voice_provider_turns.json /tmp/voice_provider_turns_v2.json /tmp/voice_provider_session_id /tmp/relay_terminal_manual_submission.json /tmp/relay_terminal_delivery_events.jsonl /tmp/tts_in.fifo /tmp/tts_control.sock /tmp/voice_bridge_heartbeat /tmp/voice_bridge_heartbeat.pid /tmp/voice_bridge.cwd /tmp/voice_bridge.provider /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
RELAY_BRIDGE='__RELAY_BRIDGE__'
RELAY_PROVIDER=claude
VOICE_BRIDGE_LOG=/tmp/voice_bridge.log
VOICE_BRIDGE_LOG_REASON=start VOICE_BRIDGE_LOG_PROVIDER="$RELAY_PROVIDER" VOICE_BRIDGE_LOG_CWD="$RELAY_CWD" "$RELAY_BRIDGE" --rotate-log
launch_relay_bridge() {
    echo "[relay-bridge] launching via launchctl provider=$RELAY_PROVIDER cwd=$RELAY_CWD bridge=$RELAY_BRIDGE" >> "$VOICE_BRIDGE_LOG"
    launchctl submit -l com.relay.voicebridge -- /bin/bash -lc 'cd "$1" || exit 1; export RELAY_RUNNER_PROVIDER="$3"; "$2" --relay >> "$4" 2>&1; status=$?; echo "[relay-bridge] launchctl bridge process exited status=$status at $(date -u "+%Y-%m-%dT%H:%M:%SZ") provider=$3" >> "$4"; exit "$status"' relay-voice "$RELAY_CWD" "$RELAY_BRIDGE" "$RELAY_PROVIDER" "$VOICE_BRIDGE_LOG" >> "$VOICE_BRIDGE_LOG" 2>&1
    submit_status=$?
    if [ "$submit_status" -eq 0 ]; then
        echo "[relay-bridge] launchctl job submission accepted exit_status=0 (submission only; bridge/provider outcome pending) provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    else
        echo "[relay-bridge] launchctl job submission failed exit_status=$submit_status provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    fi
    for i in $(seq 1 20); do
        if [ -S /tmp/voice_bridge.sock ]; then
            echo "[relay-bridge] launchctl produced socket after ${i} checks provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
            return 0
        fi
        launchctl print "gui/$(id -u)/com.relay.voicebridge" >/dev/null 2>&1 || break
        sleep 0.5
    done
    if [ -S /tmp/voice_bridge.sock ]; then
        echo "[relay-bridge] launchctl produced socket provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
        return 0
    fi
    echo "[relay-bridge] launchctl did not produce a socket; submit_status=$submit_status uid=$(id -u) provider=$RELAY_PROVIDER cwd=$RELAY_CWD; launchctl print follows." >> "$VOICE_BRIDGE_LOG"
    launchctl print "gui/$(id -u)/com.relay.voicebridge" >> "$VOICE_BRIDGE_LOG" 2>&1
    print_status=$?
    [ "$print_status" -eq 0 ] || echo "[relay-bridge] launchctl print exit_status=$print_status" >> "$VOICE_BRIDGE_LOG"
    echo "[relay-bridge] falling back to direct background launch." >> "$VOICE_BRIDGE_LOG"
    launchctl remove com.relay.voicebridge 2>/dev/null || true
    nohup /bin/bash -lc 'cd "$1" || exit 1; export RELAY_RUNNER_PROVIDER="$3"; "$2" --relay >> "$4" 2>&1; status=$?; echo "[relay-bridge] direct bridge process exited status=$status at $(date -u "+%Y-%m-%dT%H:%M:%SZ") provider=$3" >> "$4"; exit "$status"' relay-direct "$RELAY_CWD" "$RELAY_BRIDGE" "$RELAY_PROVIDER" "$VOICE_BRIDGE_LOG" >> "$VOICE_BRIDGE_LOG" 2>&1 &
    fallback_pid=$!
    echo "[relay-bridge] direct fallback launched pid=$fallback_pid provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    for i in $(seq 1 20); do
        if [ -S /tmp/voice_bridge.sock ]; then
            echo "[relay-bridge] direct fallback produced socket after ${i} checks provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
            return 0
        fi
        sleep 0.5
    done
    echo "[relay-bridge] direct fallback did not produce a socket provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    return 1
}
launch_relay_bridge
```

3. Wait for the relay bridge to come up. The 60-iteration cap is generous on purpose: the very first invocation may need to download a Python interpreter (~18 MB) and the Kokoro speech model (~350 MB) before the bridge can listen, so allow ~30 seconds:

```bash
for i in $(seq 1 60); do [ -S /tmp/voice_bridge.sock ] && echo "bridge: ok" && break; sleep 0.5; done; [ -S /tmp/voice_bridge.sock ] || echo "bridge: FAILED"
```

If the bridge failed to start, tell the user to check `/tmp/voice_bridge.log` and stop here.

4. Once the bridge is up, do not speak a second startup acknowledgement. The bridge itself greets the user through TTS.

## Voice Interaction Loop

Now enter a continuous monitoring loop. Do not treat setup confirmation, an idle wait, or a handled voice response as the end of the task. Keep a foreground wait loop active and continue claiming `/tmp/voice_cmd_ready` until the user explicitly says "stop listening", "exit voice", invokes `relay-stop`, `/tmp/voice_bridge_stop_requested` appears, or the bridge dies.

If you receive `__INTERRUPT__`, handle it as a silent control action and immediately return to waiting. Do not exit bridge mode for `__INTERRUPT__`.

### Step 0: Scan the orchestrator board

Before every wait for input, snapshot the active project's `.orchestrator/` directory and diff against the previous snapshot. You are the PM frontstage for the user, so you should know what's on the board at all times and be ready to report it without waiting to be told. Changes you should detect: tickets newly in `ready`, runs that transitioned `in_progress` → `done` (worker finished), backlog items the daemon auto-promoted to ready (dependency progression), cancellations, brand-new tickets in any column.

```bash
{
    if [ -d .orchestrator ]; then
        for f in .orchestrator/*.md; do
            [ -f "$f" ] || continue
            awk -v fn="$(basename "$f")" '
                BEGIN { id=""; title=""; status="" }
                /^---$/ { n++; next }
                n==1 && /^id:/    { sub(/^id:[ \t]*/,"");    id    = $0 }
                n==1 && /^title:/ { sub(/^title:[ \t]*/,""); title = $0 }
                n==1 && /^status:/{ sub(/^status:[ \t]*/,""); status = $0 }
                END { if (id != "") print id " [" status "] " title }
            ' "$f"
        done | sort
    fi
} > /tmp/relay_board_now.txt
if [ -f /tmp/relay_board_prev.txt ]; then
    BOARD_DIFF=$(diff /tmp/relay_board_prev.txt /tmp/relay_board_now.txt)
    if [ -n "$BOARD_DIFF" ]; then
        echo "__BOARD_CHANGES__"
        echo "$BOARD_DIFF"
        echo "__END_BOARD_CHANGES__"
    fi
fi
cp /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
```

If `__BOARD_CHANGES__` appears in the output, **remember the change set** — you'll surface it organically as part of your next response (either as a brief preface to whatever the user said, or as the response itself if the change is the meaningful event). Examples of good surfacing:
- *"R R seven just finished — want me to merge it?"* (new `done`)
- *"R R eight just landed in ready and the worker is on it."* (new `ready` with active run)
- *"R R nine moved to ready automatically because R R seven completed."* (dep-progression)

Do **not** announce changes that are just consequences of an action the user explicitly took *this turn* (e.g., they said "dispatch R R nine" — don't then read it back to them). Use judgment: announce ambient changes; stay quiet about your own work.

### Step 1: Wait for voice input

```bash
while [ ! -f /tmp/voice_cmd_ready ]; do
    sleep 0.2
    touch /tmp/voice_bridge_heartbeat
    [ -S /tmp/voice_bridge.sock ] || { echo "__BRIDGE_DIED__"; exit 0; }
done
cmd_tmp=$(mktemp /tmp/voice_cmd_claim.XXXXXX) || exit 1
meta_tmp="$cmd_tmp.meta"
if mv /tmp/voice_cmd_ready "$cmd_tmp" 2>/dev/null; then
    if [ -f /tmp/voice_cmd_ready.meta ] && mv /tmp/voice_cmd_ready.meta "$meta_tmp" 2>/dev/null; then
        cp "$meta_tmp" /tmp/voice_cmd_claimed.json
    fi
    cat "$cmd_tmp"
    if [ -f "$meta_tmp" ]; then cp "$meta_tmp" /tmp/voice_cmd_manual_ack.json.tmp && mv /tmp/voice_cmd_manual_ack.json.tmp /tmp/voice_cmd_manual_ack.json; fi
    rm -f "$cmd_tmp" "$meta_tmp"
else
    rm -f "$cmd_tmp" "$meta_tmp"
    exit 0
fi
(while sleep 2; do touch /tmp/voice_bridge_heartbeat; done) & echo $! > /tmp/voice_bridge_heartbeat.pid
```

This blocks until the user speaks via Caps Lock. If the voice bridge is killed (e.g. a new session was started), the loop exits. Once a command is read, a background heartbeat refresher is spawned so the app's watchdog doesn't reap the bridge during long Claude processing (multi-tool tasks, builds, agent spawns). The refresher is torn down in Step 3.

### Step 1.5: Preemption checkpoints

Relay messages are retained in a durable ordered intent inbox. Before starting each new shell command, MCP call, or high-stakes/irreversible action, and again before sending a final reply, check whether another classified Relay intent is waiting:

```bash
cmd_tmp=$(mktemp /tmp/voice_cmd_claim.XXXXXX) || exit 1
meta_tmp="$cmd_tmp.meta"
if [ -f /tmp/voice_cmd_ready ] && mv /tmp/voice_cmd_ready "$cmd_tmp" 2>/dev/null; then
    if [ -f /tmp/voice_cmd_ready.meta ] && mv /tmp/voice_cmd_ready.meta "$meta_tmp" 2>/dev/null; then
        cp "$meta_tmp" /tmp/voice_cmd_claimed.json
    fi
    cat "$cmd_tmp"
    if [ -f "$meta_tmp" ]; then cp "$meta_tmp" /tmp/voice_cmd_manual_ack.json.tmp && mv /tmp/voice_cmd_manual_ack.json.tmp /tmp/voice_cmd_manual_ack.json; fi
    rm -f "$cmd_tmp" "$meta_tmp"
else
    rm -f "$cmd_tmp" "$meta_tmp"
fi
```

If the checkpoint prints a normal user message, follow its `work_disposition` in `/tmp/voice_cmd_claimed.json`: additive/status/clarification turns continue or steer current work, project changes queue on Relay tickets, and only `replace_current` preempts accepted work. If it prints `__INTERRUPT__`, silently return to waiting. Do not start a high-stakes or irreversible action after its bounded authorization was revoked. If an action already completed, report that honestly when responding to the newest message.

Already-running shell commands and MCP calls cannot be forcibly preempted by the bridge. Let them return, interrupt them only when the user explicitly canceled, then run this checkpoint before any follow-up action. Codex and Claude use the same cooperative preemption contract; no provider-specific hard cancellation is assumed.

Each claimed command copies `/tmp/voice_cmd_ready.meta` to `/tmp/voice_cmd_claimed.json`. Treat that seq/id as two contracts: newest-turn freshness for replies/traces/TTS, and mutation authorization for ticket edits, ticket creation, dispatch, or other project actions. Relay-orchestrator calls carry that metadata; the daemon may allow an older bounded mutation only when Relay Runner registered it and no replacement, redirect, interrupt, or cancel turn has revoked it. Acknowledgement, inspection/status, and additive turns do not revoke prior authorized mutations.

### Step 2: Process the input

- If the text is `__BRIDGE_DIED__`, the voice session was ended (another session was started, or the bridge was stopped). Say "Voice session ended." and stop the loop — do NOT go back to Step 1. Clean up and return to normal operation.
- If the text is `__INTERRUPT__`, **silently** go back to Step 1. Do NOT generate any text response, do NOT write to `/tmp/tts_in.fifo`, do NOT acknowledge in any user-visible way. Cancel means the user wants silence — speaking again would just give them another message to cancel, which loops.
- Otherwise, resolve the text as a Relay command action before doing work. Codex and Claude follow the same command-action contract:
  - Internal controls (`__TTS_STOP__`, `__PLAY__`, `__REPLAY__`, `__INTERRUPT__`, `__CANCEL__`) are deliberate no-ticket actions.
  - Direct computer observation and control requests are foreground PM actions. Do not create a ticket, dispatch a worker, or fan them out to the Relay daemon; the messenger remains tool-free.
  - Prefer a deterministic shell or operating-system command for app launch, known-path open/reveal, and file lookup. Use Relay Vision only when visible pixels are required, then Relay Actions only when simulated UI interaction remains necessary.
  - Repo/project work must resolve the target project and create/refine a visible ticket only after the raw command has been classified into actionable work.
  - Existing ticket commands may edit/refine the ticket or dispatch a ready worker.
  - You are the foreground orchestrator/PM for the user; classify each command before deciding whether to create/refine a visible ticket or answer directly.
  - Raw Relay command captures are private metadata, not visible ticket prose. Do not paste raw transcript text into `.orchestrator/` tickets.
  - Create or edit visible `.orchestrator/` tickets only as PM management work, using refined, user-safe summaries and acceptance criteria.
  - Do not perform substantive implementation directly unless the user explicitly asks to keep the work inline.
  - Your response must name the action outcome, such as created ticket, edited ticket, dispatched worker, waiting on refined ticket content, or waiting on a target-project choice.

### Step 2.5: Send provider-visible orchestration context to the messenger

Whenever you produce a provider-visible reasoning summary or meaningful progress update, mirror a short public version to Relay Runner through the bridge control path. The persistent messenger reads this stream as conversational context while you remain the authoritative orchestrator. Use `reasoning-summary` for your public assessment or next-step summary, `clarification-request` when you need the messenger to ask the user something, plus ticket-created, dispatch-started, dispatch-claimed, run-running, run-succeeded, run-failed, and board-change for lifecycle milestones. Keep each message user-safe and bounded; never include hidden chain-of-thought, raw shell commands, raw tool output, transcript dumps, secrets, or unbounded metadata. Codex and Claude use the same trace kinds and public copy.

The bridge never speaks trace text directly. The messenger decides whether an update is useful and voices it naturally. Do not send a generic acknowledgement just to fill silence.

```bash
printf '%s\n' '__TRACE__:{"kind":"reasoning-summary","message":"Checking how the current bridge routes replies"}' > /tmp/voice_in.fifo
printf '%s\n' '__TRACE__:{"kind":"ticket-created","ticket_id":"RR-123"}' > /tmp/voice_in.fifo
printf '%s\n' '__TRACE__:{"kind":"dispatch-claimed","ticket_id":"RR-123","run_id":456}' > /tmp/voice_in.fifo
printf '%s\n' '__TRACE__:{"kind":"run-succeeded","ticket_id":"RR-123","run_id":456}' > /tmp/voice_in.fifo
```

These traces appear as the working-state notch label when no more specific compact activity label is active. Existing compact labels such as Listening, Response ready, worker state, bridge recovery, or ticket activity take priority over this stream.

### Step 3: Send the authoritative response to the messenger

After generating your response, tear down the background heartbeat refresher spawned in Step 1, then ensure the bridge session metadata remains intact. The Relay Runner app owns daemon recovery; if the daemon is missing here, preserve `/tmp/voice_bridge.cwd` and `/tmp/voice_bridge.provider`, wait briefly for the app watchdog, and skip TTS rather than deleting runtime context from the agent side:

```bash
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null; rm -f /tmp/voice_bridge_heartbeat.pid
touch /tmp/voice_bridge_heartbeat
if [ -f /tmp/voice_bridge_stop_requested ]; then
    exit 0
fi
if ! pgrep -f '[v]oice_bridge.py' > /dev/null 2>&1; then
    if [ -f /tmp/voice_bridge_stop_requested ]; then
        exit 0
    fi
    VOICE_BRIDGE_LOG=/tmp/voice_bridge.log
    RELAY_CWD="$(cat /tmp/voice_bridge.cwd 2>/dev/null || pwd)"
    RELAY_PROVIDER="$(cat /tmp/voice_bridge.provider 2>/dev/null || echo claude)"
    echo "[relay-bridge] bridge daemon missing after response; preserving session metadata for app watchdog recovery provider=${RELAY_PROVIDER:-none} cwd=$RELAY_CWD" >> "$VOICE_BRIDGE_LOG"
    for i in $(seq 1 20); do
        if [ -f /tmp/voice_bridge_stop_requested ]; then
            exit 0
        fi
        if pgrep -f '[v]oice_bridge.py' > /dev/null 2>&1; then
            break
        fi
        sleep 0.5
    done
fi
```

Then send your authoritative user-facing response through Relay's canonical reply helper. It binds and checks the claimed Relay command metadata, owns the `__ORCHESTRATOR_REPLY__:<json>` framing, and uses a nonblocking FIFO write. Do not write reply JSON to the voice FIFO yourself:

```bash
printf '%s' 'YOUR_AUTHORITATIVE_RESPONSE' | \
    RELAY_APP_SESSION_ID="${RELAY_APP_SESSION_ID:-manual-${PPID:-$$}}" \
    RELAY_RECOVERY_GENERATION="${RELAY_RECOVERY_GENERATION:-manual-${PPID:-$$}}" \
    RELAY_ACTOR_ROLE="${RELAY_ACTOR_ROLE:-foreground_manual}" \
    RELAY_FOREGROUND_GATE_HANDLE="${RELAY_FOREGROUND_GATE_HANDLE:-manual-${PPID:-$$}}" \
    /usr/bin/python3 '__RELAY_REPLY_HELPER__'
```

Important: Run the preemption checkpoint immediately before this write. If a newer Relay message is waiting, do not send a stale reply; handle the newer message instead.

### Step 4: Continue monitoring

Go back to Step 1 and wait for the next voice command. Do not stop polling because no command arrives for a while; an idle bridge session is still active. Only leave this loop for an explicit stop-listening/relay-stop request, `/tmp/voice_bridge_stop_requested`, or bridge death.

## Cleanup

When the session ends (user says "stop listening", "exit voice", or similar), clean up:

```bash
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null; rm -f /tmp/voice_bridge_heartbeat.pid
launchctl remove com.relay.voicebridge 2>/dev/null || true
: > /tmp/voice_bridge_stop_requested
pkill -f '[v]oice_bridge.py' 2>/dev/null; rm -f /tmp/voice_in.fifo /tmp/voice_bridge.sock /tmp/voice_cmd_ready /tmp/voice_cmd_ready.meta /tmp/voice_command_state.json /tmp/voice_cmd_claimed.json /tmp/voice_cmd_manual_ack.json /tmp/voice_command_authorizations.json /tmp/voice_provider_turns.json /tmp/voice_provider_turns_v2.json /tmp/voice_provider_session_id /tmp/relay_terminal_manual_submission.json /tmp/relay_terminal_delivery_events.jsonl /tmp/tts_in.fifo /tmp/tts_control.sock /tmp/voice_bridge_heartbeat /tmp/voice_bridge_heartbeat.pid /tmp/voice_bridge.cwd /tmp/voice_bridge.provider /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
```

## Important Notes

- You are in a normal Claude session with full tool access. Voice input is just another way for the user to send messages.
- Speak concisely. TTS responses should be 1-3 sentences summarizing what you did or what you found. The user can read the full detail in the conversation.
- If the user asks you to run commands, edit files, or do project work, first resolve the command action above. Do the implementation inline only when the command explicitly asks for inline work.
- The relay daemon handles Caps Lock detection, STT, and TTS playback. You just read commands and write responses.
BRIDGE_MD_EOF
    # Substitute the relay-bridge absolute path. Use | as the sed
    # delimiter so / in $relay_bridge_path doesn't conflict.
    # In-place edit via tmp file (BSD/macOS sed -i takes a backup
    # suffix arg, GNU doesn't — round-trip via mv is portable).
    sed \
        -e "s|__RELAY_BRIDGE__|$relay_bridge_path|g" \
        -e "s|__RELAY_REPLY_HELPER__|$relay_reply_helper_path|g" \
        "$staged" > "$staged.tmp" && mv "$staged.tmp" "$staged"
    install_relay_command "$mode" "$staged" "$bridge_md"

    staged="$stop_md.relay-new"
    cat > "$staged" <<'STOP_MD_EOF'
Stop the voice I/O bridge for this Claude session. Use this to end a `/relay-bridge` voice session cleanly without exiting Claude Code.

## Steps

1. Kill the voice bridge process and remove its runtime files:

```bash
launchctl remove com.relay.voicebridge 2>/dev/null || true
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null || true
: > /tmp/voice_bridge_stop_requested
pkill -f '[v]oice_bridge.py' 2>/dev/null; rm -f /tmp/voice_in.fifo /tmp/voice_bridge.sock /tmp/voice_cmd_ready /tmp/voice_cmd_ready.meta /tmp/voice_command_state.json /tmp/voice_cmd_claimed.json /tmp/voice_cmd_manual_ack.json /tmp/voice_command_authorizations.json /tmp/voice_provider_turns.json /tmp/voice_provider_turns_v2.json /tmp/voice_provider_session_id /tmp/relay_terminal_manual_submission.json /tmp/relay_terminal_delivery_events.jsonl /tmp/tts_in.fifo /tmp/tts_control.sock /tmp/voice_bridge_heartbeat /tmp/voice_bridge_heartbeat.pid /tmp/voice_bridge.cwd /tmp/voice_bridge.provider /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
```

2. Confirm it's stopped:

```bash
pgrep -f '[v]oice_bridge.py' > /dev/null 2>&1 && echo "bridge: STILL RUNNING" || echo "bridge: stopped"
```

If the bridge is still running, tell the user to check `/tmp/voice_bridge.log` and try again. Otherwise, tell the user the voice session has ended.

## Notes

- This only stops the voice bridge. The Relay Runner menu bar app keeps running.
- Any active `/relay-bridge` voice loop in another Claude session will detect the dead socket on its next heartbeat and exit on its own.
- To start voice again, run `/relay-bridge`.
STOP_MD_EOF
    install_relay_command "$mode" "$staged" "$stop_md"

    staged="$codex_bridge_md.relay-new"
    cat > "$staged" <<'CODEX_BRIDGE_MD_EOF'
---
name: relay-bridge
description: Connect voice I/O to an existing Codex session. Use for manual voice sessions; Relay Runner Start Session uses app-managed nonblocking delivery.
---

# relay-bridge

Connect voice I/O to this Codex session when invoked manually. Relay Runner's menu-bar Start Session path owns a nonblocking app-managed transport instead of running this foreground loop.

## Setup

If `${RELAY_RUNNER_APP_SESSION:-0}` is `1`, the menu-bar Start Session path already owns bridge startup, heartbeat, and PTY delivery. Do not run this skill unless the user explicitly asked to replace that app-managed session with a manual relay-bridge loop.

1. Verify the Relay Runner app is running:

```bash
if [ "${RELAY_RUNNER_APP_SESSION:-0}" = "1" ] || pgrep -f 'relay-runner' > /dev/null 2>&1; then echo "app: ok"; else echo "app: NOT RUNNING"; fi
```

If not running, tell the user to start the Relay Runner menu bar app, then stop.

2. Kill any existing voice bridge and start a new one in relay mode:

```bash
launchctl remove com.relay.voicebridge 2>/dev/null || true
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null || true
rm -f /tmp/voice_bridge_stop_requested
pkill -f '[v]oice_bridge.py' 2>/dev/null; rm -f /tmp/voice_in.fifo /tmp/voice_bridge.sock /tmp/voice_cmd_ready /tmp/voice_cmd_ready.meta /tmp/voice_command_state.json /tmp/voice_cmd_claimed.json /tmp/voice_cmd_manual_ack.json /tmp/voice_command_authorizations.json /tmp/voice_provider_turns.json /tmp/voice_provider_turns_v2.json /tmp/voice_provider_session_id /tmp/relay_terminal_manual_submission.json /tmp/relay_terminal_delivery_events.jsonl /tmp/tts_in.fifo /tmp/tts_control.sock /tmp/voice_bridge_heartbeat /tmp/voice_bridge_heartbeat.pid /tmp/voice_bridge.cwd /tmp/voice_bridge.provider /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
RELAY_CWD=$(pwd)
RELAY_BRIDGE='__RELAY_BRIDGE__'
RELAY_PROVIDER=codex
VOICE_BRIDGE_LOG=/tmp/voice_bridge.log
VOICE_BRIDGE_LOG_REASON=start VOICE_BRIDGE_LOG_PROVIDER="$RELAY_PROVIDER" VOICE_BRIDGE_LOG_CWD="$RELAY_CWD" "$RELAY_BRIDGE" --rotate-log
launch_relay_bridge() {
    echo "[relay-bridge] launching via launchctl provider=$RELAY_PROVIDER cwd=$RELAY_CWD bridge=$RELAY_BRIDGE" >> "$VOICE_BRIDGE_LOG"
    launchctl submit -l com.relay.voicebridge -- /bin/bash -lc 'cd "$1" || exit 1; export RELAY_RUNNER_PROVIDER="$3"; "$2" --relay >> "$4" 2>&1; status=$?; echo "[relay-bridge] launchctl bridge process exited status=$status at $(date -u "+%Y-%m-%dT%H:%M:%SZ") provider=$3" >> "$4"; exit "$status"' relay-voice "$RELAY_CWD" "$RELAY_BRIDGE" "$RELAY_PROVIDER" "$VOICE_BRIDGE_LOG" >> "$VOICE_BRIDGE_LOG" 2>&1
    submit_status=$?
    if [ "$submit_status" -eq 0 ]; then
        echo "[relay-bridge] launchctl job submission accepted exit_status=0 (submission only; bridge/provider outcome pending) provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    else
        echo "[relay-bridge] launchctl job submission failed exit_status=$submit_status provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    fi
    for i in $(seq 1 20); do
        if [ -S /tmp/voice_bridge.sock ]; then
            echo "[relay-bridge] launchctl produced socket after ${i} checks provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
            return 0
        fi
        launchctl print "gui/$(id -u)/com.relay.voicebridge" >/dev/null 2>&1 || break
        sleep 0.5
    done
    if [ -S /tmp/voice_bridge.sock ]; then
        echo "[relay-bridge] launchctl produced socket provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
        return 0
    fi
    echo "[relay-bridge] launchctl did not produce a socket; submit_status=$submit_status uid=$(id -u) provider=$RELAY_PROVIDER cwd=$RELAY_CWD; launchctl print follows." >> "$VOICE_BRIDGE_LOG"
    launchctl print "gui/$(id -u)/com.relay.voicebridge" >> "$VOICE_BRIDGE_LOG" 2>&1
    print_status=$?
    [ "$print_status" -eq 0 ] || echo "[relay-bridge] launchctl print exit_status=$print_status" >> "$VOICE_BRIDGE_LOG"
    echo "[relay-bridge] falling back to direct background launch." >> "$VOICE_BRIDGE_LOG"
    launchctl remove com.relay.voicebridge 2>/dev/null || true
    nohup /bin/bash -lc 'cd "$1" || exit 1; export RELAY_RUNNER_PROVIDER="$3"; "$2" --relay >> "$4" 2>&1; status=$?; echo "[relay-bridge] direct bridge process exited status=$status at $(date -u "+%Y-%m-%dT%H:%M:%SZ") provider=$3" >> "$4"; exit "$status"' relay-direct "$RELAY_CWD" "$RELAY_BRIDGE" "$RELAY_PROVIDER" "$VOICE_BRIDGE_LOG" >> "$VOICE_BRIDGE_LOG" 2>&1 &
    fallback_pid=$!
    echo "[relay-bridge] direct fallback launched pid=$fallback_pid provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    for i in $(seq 1 20); do
        if [ -S /tmp/voice_bridge.sock ]; then
            echo "[relay-bridge] direct fallback produced socket after ${i} checks provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
            return 0
        fi
        sleep 0.5
    done
    echo "[relay-bridge] direct fallback did not produce a socket provider=$RELAY_PROVIDER" >> "$VOICE_BRIDGE_LOG"
    return 1
}
launch_relay_bridge
```

3. Wait for the bridge:

```bash
for i in $(seq 1 60); do [ -S /tmp/voice_bridge.sock ] && echo "bridge: ok" && break; sleep 0.5; done; [ -S /tmp/voice_bridge.sock ] || echo "bridge: FAILED"
```

If the bridge failed, tell the user to check `/tmp/voice_bridge.log` and stop.

4. Once the bridge is up, do not speak a second startup acknowledgement. The bridge itself greets the user through TTS.

## Voice Loop

Bridge mode is an active monitoring contract. Do not treat setup confirmation, an idle wait, or a handled voice response as the end of the task. Keep a foreground wait loop active and continue claiming `/tmp/voice_cmd_ready` until the user explicitly asks to stop listening, invokes `relay-stop`, `/tmp/voice_bridge_stop_requested` appears, or the bridge dies.

Do not send a final response just because startup succeeded or one voice command was handled if doing so would stop the wait loop. After each handled command and spoken summary, immediately return to this loop and wait for the next command.

Before each wait, snapshot `.orchestrator/` if it exists and remember meaningful board changes:

```bash
{
    if [ -d .orchestrator ]; then
        for f in .orchestrator/*.md; do
            [ -f "$f" ] || continue
            awk '
                BEGIN { id=""; title=""; status="" }
                /^---$/ { n++; next }
                n==1 && /^id:/     { sub(/^id:[ \t]*/,"");     id = $0 }
                n==1 && /^title:/  { sub(/^title:[ \t]*/,"");  title = $0 }
                n==1 && /^status:/ { sub(/^status:[ \t]*/,""); status = $0 }
                END { if (id != "") print id " [" status "] " title }
            ' "$f"
        done | sort
    fi
} > /tmp/relay_board_now.txt
if [ -f /tmp/relay_board_prev.txt ]; then
    BOARD_DIFF=$(diff /tmp/relay_board_prev.txt /tmp/relay_board_now.txt)
    if [ -n "$BOARD_DIFF" ]; then
        echo "__BOARD_CHANGES__"
        echo "$BOARD_DIFF"
        echo "__END_BOARD_CHANGES__"
    fi
fi
cp /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
```

Wait for voice input:

```bash
while [ ! -f /tmp/voice_cmd_ready ]; do
    sleep 0.2
    touch /tmp/voice_bridge_heartbeat
    [ -S /tmp/voice_bridge.sock ] || { echo "__BRIDGE_DIED__"; exit 0; }
done
cmd_tmp=$(mktemp /tmp/voice_cmd_claim.XXXXXX) || exit 1
meta_tmp="$cmd_tmp.meta"
if mv /tmp/voice_cmd_ready "$cmd_tmp" 2>/dev/null; then
    if [ -f /tmp/voice_cmd_ready.meta ] && mv /tmp/voice_cmd_ready.meta "$meta_tmp" 2>/dev/null; then
        cp "$meta_tmp" /tmp/voice_cmd_claimed.json
    fi
    cat "$cmd_tmp"
    if [ -f "$meta_tmp" ]; then cp "$meta_tmp" /tmp/voice_cmd_manual_ack.json.tmp && mv /tmp/voice_cmd_manual_ack.json.tmp /tmp/voice_cmd_manual_ack.json; fi
    rm -f "$cmd_tmp" "$meta_tmp"
else
    rm -f "$cmd_tmp" "$meta_tmp"
    exit 0
fi
(while sleep 2; do touch /tmp/voice_bridge_heartbeat; done) & echo $! > /tmp/voice_bridge_heartbeat.pid
```

Preemption checkpoints:

Relay messages are retained in a durable ordered intent inbox. Before starting each new shell command, MCP call, or high-stakes/irreversible action, and again before sending a final reply, check whether another classified Relay intent is waiting:

```bash
cmd_tmp=$(mktemp /tmp/voice_cmd_claim.XXXXXX) || exit 1
meta_tmp="$cmd_tmp.meta"
if [ -f /tmp/voice_cmd_ready ] && mv /tmp/voice_cmd_ready "$cmd_tmp" 2>/dev/null; then
    if [ -f /tmp/voice_cmd_ready.meta ] && mv /tmp/voice_cmd_ready.meta "$meta_tmp" 2>/dev/null; then
        cp "$meta_tmp" /tmp/voice_cmd_claimed.json
    fi
    cat "$cmd_tmp"
    if [ -f "$meta_tmp" ]; then cp "$meta_tmp" /tmp/voice_cmd_manual_ack.json.tmp && mv /tmp/voice_cmd_manual_ack.json.tmp /tmp/voice_cmd_manual_ack.json; fi
    rm -f "$cmd_tmp" "$meta_tmp"
else
    rm -f "$cmd_tmp" "$meta_tmp"
fi
```

If the checkpoint prints a normal user message, follow its `work_disposition` in `/tmp/voice_cmd_claimed.json`: additive/status/clarification turns continue or steer current work, project changes queue on Relay tickets, and only `replace_current` preempts accepted work. If it prints `__INTERRUPT__`, silently return to waiting. Do not start a high-stakes or irreversible action after its bounded authorization was revoked. If an action already completed, report that honestly when responding to the newest message.

Already-running shell commands and MCP calls cannot be forcibly preempted by the bridge. Let them return, interrupt them only when the user explicitly canceled, then run this checkpoint before any follow-up action. Codex and Claude use the same cooperative preemption contract; no provider-specific hard cancellation is assumed.

Each claimed command copies `/tmp/voice_cmd_ready.meta` to `/tmp/voice_cmd_claimed.json`. Treat that seq/id as two contracts: newest-turn freshness for replies/traces/TTS, and mutation authorization for ticket edits, ticket creation, dispatch, or other project actions. Relay-orchestrator calls carry that metadata; the daemon may allow an older bounded mutation only when Relay Runner registered it and no replacement, redirect, interrupt, or cancel turn has revoked it. Acknowledgement, inspection/status, and additive turns do not revoke prior authorized mutations.

Interpret the text:
- `__BRIDGE_DIED__`: say "Voice session ended." and stop.
- `__INTERRUPT__`: silently return to waiting. Do not respond or write TTS.
- Otherwise, resolve it as a Relay command action before doing work. Codex and Claude follow the same command-action contract:
  - Internal controls (`__TTS_STOP__`, `__PLAY__`, `__REPLAY__`, `__INTERRUPT__`, `__CANCEL__`) are deliberate no-ticket actions.
  - Direct computer observation and control requests are foreground PM actions. Do not create a ticket, dispatch a worker, or fan them out to the Relay daemon; the messenger remains tool-free.
  - Prefer a deterministic shell or operating-system command for app launch, known-path open/reveal, and file lookup. Use Relay Vision only when visible pixels are required, then Relay Actions only when simulated UI interaction remains necessary.
  - Repo/project work must resolve the target project and create/refine a visible ticket only after the raw command has been classified into actionable work.
  - Existing ticket commands may edit/refine the ticket or dispatch a ready worker.
  - You are the foreground orchestrator/PM for the user; classify each command before deciding whether to create/refine a visible ticket or answer directly.
  - Raw Relay command captures are private metadata, not visible ticket prose. Do not paste raw transcript text into `.orchestrator/` tickets.
  - Create or edit visible `.orchestrator/` tickets only as PM management work, using refined, user-safe summaries and acceptance criteria.
  - Do not perform substantive implementation directly unless the user explicitly asks to keep the work inline.
  - Your response must name the action outcome, such as created ticket, edited ticket, dispatched worker, waiting on refined ticket content, or waiting on a target-project choice.

Send provider-visible orchestration context to the messenger:

Whenever you produce a provider-visible reasoning summary or meaningful progress update, mirror a short public version to Relay Runner through the bridge control path. The persistent messenger reads this stream as conversational context while you remain the authoritative orchestrator. Use `reasoning-summary` for your public assessment or next-step summary, `clarification-request` when you need the messenger to ask the user something, plus ticket-created, dispatch-started, dispatch-claimed, run-running, run-succeeded, run-failed, and board-change for lifecycle milestones. Keep each message user-safe and bounded; never include hidden chain-of-thought, raw shell commands, raw tool output, transcript dumps, secrets, or unbounded metadata. Codex and Claude use the same trace kinds and public copy.

The bridge never speaks trace text directly. The messenger decides whether an update is useful and voices it naturally. Do not send a generic acknowledgement just to fill silence.

```bash
printf '%s\n' '__TRACE__:{"kind":"reasoning-summary","message":"Checking how the current bridge routes replies"}' > /tmp/voice_in.fifo
printf '%s\n' '__TRACE__:{"kind":"ticket-created","ticket_id":"RR-123"}' > /tmp/voice_in.fifo
printf '%s\n' '__TRACE__:{"kind":"dispatch-claimed","ticket_id":"RR-123","run_id":456}' > /tmp/voice_in.fifo
printf '%s\n' '__TRACE__:{"kind":"run-succeeded","ticket_id":"RR-123","run_id":456}' > /tmp/voice_in.fifo
```

These traces appear as the working-state notch label when no more specific compact activity label is active. Existing compact labels such as Listening, Response ready, worker state, bridge recovery, or ticket activity take priority over this stream.

After each handled command, stop only that command's heartbeat refresher and ensure the bridge session metadata remains intact. This is not session cleanup, and it must not end bridge monitoring. The Relay Runner app owns daemon recovery; if the daemon is missing here, preserve `/tmp/voice_bridge.cwd` and `/tmp/voice_bridge.provider`, wait briefly for the app watchdog, and skip TTS rather than deleting runtime context from the agent side:

```bash
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null; rm -f /tmp/voice_bridge_heartbeat.pid
touch /tmp/voice_bridge_heartbeat
if [ -f /tmp/voice_bridge_stop_requested ]; then
    exit 0
fi
if ! pgrep -f '[v]oice_bridge.py' > /dev/null 2>&1; then
    if [ -f /tmp/voice_bridge_stop_requested ]; then
        exit 0
    fi
    VOICE_BRIDGE_LOG=/tmp/voice_bridge.log
    RELAY_CWD="$(cat /tmp/voice_bridge.cwd 2>/dev/null || pwd)"
    RELAY_PROVIDER="$(cat /tmp/voice_bridge.provider 2>/dev/null || echo codex)"
    echo "[relay-bridge] bridge daemon missing after response; preserving session metadata for app watchdog recovery provider=${RELAY_PROVIDER:-none} cwd=$RELAY_CWD" >> "$VOICE_BRIDGE_LOG"
    for i in $(seq 1 20); do
        if [ -f /tmp/voice_bridge_stop_requested ]; then
            exit 0
        fi
        if pgrep -f '[v]oice_bridge.py' > /dev/null 2>&1; then
            break
        fi
        sleep 0.5
    done
fi
```

Send the authoritative user-facing response through Relay's canonical reply helper. It binds and checks the claimed Relay command metadata, owns the `__ORCHESTRATOR_REPLY__:<json>` framing, and uses a nonblocking FIFO write. Do not write reply JSON to the voice FIFO yourself:

```bash
printf '%s' 'YOUR_AUTHORITATIVE_RESPONSE' | \
    RELAY_APP_SESSION_ID="${RELAY_APP_SESSION_ID:-manual-${PPID:-$$}}" \
    RELAY_RECOVERY_GENERATION="${RELAY_RECOVERY_GENERATION:-manual-${PPID:-$$}}" \
    RELAY_ACTOR_ROLE="${RELAY_ACTOR_ROLE:-foreground_manual}" \
    RELAY_FOREGROUND_GATE_HANDLE="${RELAY_FOREGROUND_GATE_HANDLE:-manual-${PPID:-$$}}" \
    /usr/bin/python3 '__RELAY_REPLY_HELPER__'
```

Run the preemption checkpoint immediately before this write. If a newer Relay message is waiting, do not send a stale reply; handle the newer message instead.

### Continue monitoring

After the spoken summary path completes, immediately go back to the top of the Voice Loop and wait for the next voice command. Do not stop polling because no command arrives for a while; an idle bridge session is still active. Only leave this loop for an explicit stop-listening/relay-stop request, `/tmp/voice_bridge_stop_requested`, or bridge death.

## Cleanup

When the session ends:

```bash
[ -f /tmp/voice_bridge_heartbeat.pid ] && kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null; rm -f /tmp/voice_bridge_heartbeat.pid
launchctl remove com.relay.voicebridge 2>/dev/null || true
: > /tmp/voice_bridge_stop_requested
pkill -f '[v]oice_bridge.py' 2>/dev/null; rm -f /tmp/voice_in.fifo /tmp/voice_bridge.sock /tmp/voice_cmd_ready /tmp/voice_cmd_ready.meta /tmp/voice_command_state.json /tmp/voice_cmd_claimed.json /tmp/voice_cmd_manual_ack.json /tmp/voice_command_authorizations.json /tmp/voice_provider_turns.json /tmp/voice_provider_turns_v2.json /tmp/voice_provider_session_id /tmp/relay_terminal_manual_submission.json /tmp/relay_terminal_delivery_events.jsonl /tmp/tts_in.fifo /tmp/tts_control.sock /tmp/voice_bridge_heartbeat /tmp/voice_bridge_heartbeat.pid /tmp/voice_bridge.cwd /tmp/voice_bridge.provider /tmp/relay_board_now.txt /tmp/relay_board_prev.txt
```
CODEX_BRIDGE_MD_EOF
    sed \
        -e "s|__RELAY_BRIDGE__|$relay_bridge_path|g" \
        -e "s|__RELAY_REPLY_HELPER__|$relay_reply_helper_path|g" \
        "$staged" > "$staged.tmp" && mv "$staged.tmp" "$staged"
