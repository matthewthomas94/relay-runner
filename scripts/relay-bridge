#!/bin/bash
# relay-bridge -- Start voice I/O pipeline (STT sidecar + voice bridge).
#
# Usage:
#   relay-bridge                     # Relay daemon for Start Session / relay-bridge skills
#   relay-bridge --relay             # Same as default; kept for existing skill launchers
#   relay-bridge --venv-only         # Run venv bootstrap and exit 0 (used by onboarding)
#   relay-bridge --start-daemon      # Bootstrap, launch detached bridge daemon, exit
#   relay-bridge --suppress-startup-greeting
#                                    # Skip the initial TTS greeting for tutorial sessions
#   relay-bridge --install-skills    # Force-write Relay skills/commands and exit 0
#   relay-bridge --refresh-skills    # Install/refresh unmodified Relay skills, keep user edits
#   relay-bridge --register-mcp <server> <binary> <label>
#                                    # Register/repair one MCP server for available agents
#
# Supported voice sessions run through Start Session or the installed
# relay-bridge skill/command. The old full-terminal direct mode lives only in
# services/voice_bridge.py for legacy manual debugging.
#
# Voice commands are written to /tmp/voice_cmd_ready for the agent to pick up,
# and a persistent tool-free messenger owns normal TTS replies.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# -- Paths --
# Read-only services bundled inside the .app (or repo, for dev): the
# Python source files and requirements.txt that ship with each release.
SERVICES_BUNDLE="$PROJECT_ROOT/services"
# Writable runtime data — venv + downloaded Python live here so the
# install path works for non-admin users with no Homebrew or system
# Python. Admin is required to install Homebrew or run macOS package
# installers, but ~/Library is always user-writable.
USER_DATA_DIR="$HOME/Library/Application Support/relay-runner"
SERVICES_DIR="$USER_DATA_DIR/services"
RELOCATABLE_PYTHON_DIR="$USER_DATA_DIR/python"
RELOCATABLE_PYTHON="$RELOCATABLE_PYTHON_DIR/bin/python3"
mkdir -p "$SERVICES_DIR"
VOICE_FIFO="/tmp/voice_in.fifo"
BRIDGE_SOCK="/tmp/voice_bridge.sock"
BRIDGE_STOP_REQUESTED_FILE="/tmp/voice_bridge_stop_requested"
# Records the cwd of whoever launched the bridge so the menu-bar app can
# classify the active session as either a workspace root or a project repo.
# Single-project repos get .orchestrator/config.toml initialized on
# activation if needed; workspace roots do not get a parent board.
BRIDGE_CWD_FILE="/tmp/voice_bridge.cwd"
BRIDGE_PROVIDER_FILE="/tmp/voice_bridge.provider"
BRIDGE_RUNTIME_FILES=(
    "$VOICE_FIFO"
    "$BRIDGE_SOCK"
    "/tmp/voice_cmd_ready"
    "/tmp/voice_cmd_ready.meta"
    "/tmp/voice_command_state.json"
    "/tmp/voice_cmd_claimed.json"
    "/tmp/voice_cmd_manual_ack.json"
    "/tmp/voice_provider_turns.json"
    "/tmp/voice_provider_turns_v2.json"
    "/tmp/voice_provider_session_id"
    "/tmp/relay_terminal_manual_submission.json"
    "/tmp/relay_terminal_delivery_events.jsonl"
    "/tmp/tts_in.fifo"
    "/tmp/tts_control.sock"
    "/tmp/voice_bridge_heartbeat"
    "/tmp/voice_bridge_heartbeat.pid"
    "$BRIDGE_CWD_FILE"
    "$BRIDGE_PROVIDER_FILE"
    "/tmp/relay_board_now.txt"
    "/tmp/relay_board_prev.txt"
)

CONFIG_DIR="${XDG_CONFIG_HOME:-}"
if [ -z "$CONFIG_DIR" ]; then
    if [ "$(uname)" = "Darwin" ]; then
        CONFIG_DIR="$HOME/Library/Application Support"
    else
        CONFIG_DIR="$HOME/.config"
    fi
fi
CONFIG_PATH="$CONFIG_DIR/relay-runner/config.toml"

# Export PROJECT_ROOT so the slash command can find us
export PROJECT_ROOT
export PYTHONDONTWRITEBYTECODE=1

# -- Parse our own flags before passing the rest to voice_bridge.py --
# --venv-only: run only the venv bootstrap below, then exit. Used by
# the app's onboarding flow so it can call into the same battle-tested
# Python setup that interactive /relay-bridge sessions use, with output
# streamed back to the SwiftUI progress view.
# --install-skills: write Relay Runner command/skill files for Claude Code
# and Codex, then exit. Used by Settings → Install Skill so the template
# content lives here as a single source of truth instead of being duplicated
# as Swift literals. --refresh-skills is the edit-preserving variant used
# before every Start Session and by relay-orchestrator --install.
VENV_ONLY=false
INSTALL_SKILLS_ONLY=false
REFRESH_SKILLS_ONLY=false
ROTATE_LOG_ONLY=false
START_DAEMON_ONLY=false
SUPPRESS_STARTUP_GREETING=false

if [ -z "${RELAY_CORRELATION_ID:-}" ]; then
    RELAY_CORRELATION_ID="shell-$(date +%s)-$$"
    export RELAY_CORRELATION_ID
fi

# Emit a progress marker the SwiftUI installer can parse to drive a
# determinate progress bar. Format: `RELAY_PROGRESS:<percent>:<label>`.
# Percent is 0–100, label is a short human-readable description of the
# current phase. Interactive callers see the same line as plain output;
# the SwiftUI side strips the `RELAY_PROGRESS:` prefix and treats the
# rest as structured. Keep labels short — they show up under a progress
# bar with limited horizontal space.
#
# Writes to stderr so it doesn't contaminate functions whose stdout
# the caller captures (e.g. `find_python`, `ensure_relocatable_python`).
# The SwiftUI parser merges stdout + stderr into one pipe, so it still
# sees these lines.
emit_progress() {
    local percent="$1"
    local max_percent="${RELAY_PROGRESS_MAX_PERCENT:-100}"
    if [[ ! "$max_percent" =~ ^[0-9]+$ ]] || [ "$max_percent" -gt 100 ]; then
        max_percent=100
    fi
    # A parent installer can reserve the remainder of its own progress range.
    # relay-orchestrator uses this to map bridge completion into its runtime
    # bootstrap phase instead of letting a nested 100 fill the onboarding bar.
    percent=$((percent * max_percent / 100))
    echo "RELAY_PROGRESS:$percent:$2" >&2
}

support_file_mtime() {
    stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1" 2>/dev/null || echo 0
}

support_file_size() {
    stat -f '%z' "$1" 2>/dev/null || stat -c '%s' "$1" 2>/dev/null || echo 0
}

support_safe_id() {
    [ "${#1}" -le 64 ] && [[ "$1" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ \
        || "$1" =~ ^inc-[0-9a-f]{12}$ \
        || "$1" =~ ^(shell|orchestrator)-[0-9]{10,}-[0-9]+$ ]]
}

acquire_support_journal_lock() {
    local directory="$1"
    local lock="$directory/.journal.lock"
    local attempts=0 now mtime stale
    while ! mkdir "$lock" 2>/dev/null; do
        now="$(date +%s)"
        mtime="$(support_file_mtime "$lock")"
        if [ "$mtime" -gt 0 ] && [ $((now - mtime)) -ge 30 ]; then
            stale="$directory/.journal.lock.stale-$$-$attempts"
            if mv "$lock" "$stale" 2>/dev/null; then
                rm -rf "$stale"
                continue
            fi
        fi
        attempts=$((attempts + 1))
        [ "$attempts" -lt 100 ] || return 1
        sleep 0.05
    done
}

release_support_journal_lock() {
    rm -rf "$1/.journal.lock"
}

prune_support_journals() {
    local directory="$1"
    local cutoff file mtime size total oldest oldest_mtime
    cutoff=$(($(date +%s) - 604800))
    for file in "$directory"/events-v1-*.jsonl; do
        [ -f "$file" ] || continue
        mtime="$(support_file_mtime "$file")"
        if [ "$mtime" -lt "$cutoff" ]; then
            rm -f "$file"
        fi
    done

    total=0
    for file in "$directory"/events-v1-*.jsonl; do
        [ -f "$file" ] || continue
        size="$(support_file_size "$file")"
        total=$((total + size))
    done
    while [ "$total" -gt 5242880 ]; do
        oldest=""
        oldest_mtime=""
        for file in "$directory"/events-v1-*.jsonl; do
            [ -f "$file" ] || continue
            mtime="$(support_file_mtime "$file")"
            if [ -z "$oldest" ] || [ "$mtime" -lt "$oldest_mtime" ] \
                || { [ "$mtime" -eq "$oldest_mtime" ] && [[ "$file" < "$oldest" ]]; }; then
                oldest="$file"
                oldest_mtime="$mtime"
            fi
        done
        [ -n "$oldest" ] || break
        size="$(support_file_size "$oldest")"
        rm -f "$oldest"
        total=$((total - size))
    done
}

record_support_event() {
    local process="$1"
    local phase="$2"
    local outcome="$3"
    local provider="${4:-${RELAY_RUNNER_PROVIDER:-}}"
    local directory="${RELAY_DIAGNOSTICS_DIR:-$HOME/Library/Application Support/relay-runner/support-diagnostics/v1}"
    local app_session correlation provider_json incident_json retry_json raw_id redaction_count=0
    case "$process:$phase:$outcome" in
        shell:setup:started|shell:setup:ready|shell:setup:failed|shell:bridge_readiness:started|shell:bridge_readiness:ready|shell:bridge_readiness:failed) ;;
        *) return 0 ;;
    esac
    raw_id="${RELAY_APP_SESSION_ID:-shell-$(date +%s)-$$}"
    if support_safe_id "$raw_id"; then app_session="$raw_id"; else app_session="redacted-id"; redaction_count=$((redaction_count + 1)); fi
    raw_id="${RELAY_CORRELATION_ID:-shell-$(date +%s)-$$}"
    if support_safe_id "$raw_id"; then correlation="$raw_id"; else correlation="redacted-id"; redaction_count=$((redaction_count + 1)); fi
    case "$provider" in
        codex|claude) provider_json="\"$provider\"" ;;
        *) provider_json="null"; [ -z "$provider" ] || redaction_count=$((redaction_count + 1)) ;;
    esac
    incident_json="null"
    if [ -n "${RELAY_INCIDENT_ID:-}" ]; then
        if support_safe_id "$RELAY_INCIDENT_ID"; then
            incident_json="\"$RELAY_INCIDENT_ID\""
        else
            incident_json='"redacted-id"'
            redaction_count=$((redaction_count + 1))
        fi
    fi
    case "${RELAY_RETRY_ATTEMPT:-}" in
        ''|0) retry_json="null" ;;
        *[!0-9]*) retry_json="null"; redaction_count=$((redaction_count + 1)) ;;
        *) retry_json="$RELAY_RETRY_ATTEMPT" ;;
    esac
    mkdir -p "$directory" 2>/dev/null || return 0
    chmod 700 "$directory" 2>/dev/null || true
    acquire_support_journal_lock "$directory" || return 0
    printf '{"app_session_id":"%s","attributes":{},"correlation_id":"%s","incident_id":%s,"outcome":"%s","phase":"%s","process":"%s","provider":%s,"redaction_count":%s,"retry_attempt":%s,"schema_version":1,"summary":null,"timestamp":"%s"}\n' \
        "$app_session" "$correlation" "$incident_json" "$outcome" "$phase" "$process" "$provider_json" "$redaction_count" "$retry_json" \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        >> "$directory/events-v1-$process-$$.jsonl" 2>/dev/null || true
    chmod 600 "$directory/events-v1-$process-$$.jsonl" 2>/dev/null || true
    prune_support_journals "$directory"
    release_support_journal_lock "$directory"
}

cleanup_bridge_runtime_files() {
    if [ -f /tmp/voice_bridge_heartbeat.pid ]; then
        kill "$(cat /tmp/voice_bridge_heartbeat.pid)" 2>/dev/null || true
    fi
    rm -f "${BRIDGE_RUNTIME_FILES[@]}"
}

ensure_fifo() {
    local path="$1"
    if [ -e "$path" ] && [ ! -p "$path" ]; then
        rm -f "$path"
    fi
    [ -p "$path" ] || mkfifo "$path" 2>/dev/null || true
}

voice_bridge_log_path() {
    echo "${VOICE_BRIDGE_LOG_PATH:-/tmp/voice_bridge.log}"
}

record_embedded_session_event() {
    local event_path="${RELAY_SESSION_EVENTS:-}"
    [ -n "$event_path" ] || return 0
    if [ -n "${3:-}" ]; then
        printf '{"exit_status":%s,"outcome":"%s","stage":"%s","timestamp":"%s"}\n' \
            "$3" "$2" "$1" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
            >> "$event_path" 2>/dev/null || true
    else
        printf '{"outcome":"%s","stage":"%s","timestamp":"%s"}\n' \
            "$2" "$1" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
            >> "$event_path" 2>/dev/null || true
    fi
    chmod 600 "$event_path" 2>/dev/null || true
}

voice_bridge_log_stamp() {
    if [ -n "${VOICE_BRIDGE_LOG_TIMESTAMP:-}" ]; then
        echo "$VOICE_BRIDGE_LOG_TIMESTAMP"
    else
        date -u '+%Y%m%d-%H%M%S'
    fi
}

rotate_voice_bridge_log() {
    local log_path
    log_path="$(voice_bridge_log_path)"
    local reason="${VOICE_BRIDGE_LOG_REASON:-startup}"
    local provider="${VOICE_BRIDGE_LOG_PROVIDER:-${RELAY_RUNNER_PROVIDER:-unknown}}"
    local cwd="${VOICE_BRIDGE_LOG_CWD:-$PWD}"
    local previous="none"
    local log_dir log_name stem ext stamp candidate i

    log_dir="$(dirname "$log_path")"
    log_name="$(basename "$log_path")"
    stem="${log_name%.*}"
    if [ "$stem" = "$log_name" ]; then
        ext=".log"
    else
        ext=".${log_name##*.}"
    fi
    mkdir -p "$log_dir"

    if [ -s "$log_path" ]; then
        stamp="$(voice_bridge_log_stamp)"
        candidate="$log_dir/$stem.$stamp$ext"
        i=1
        while [ -e "$candidate" ]; do
            candidate="$log_dir/$stem.$stamp.$i$ext"
            i=$((i + 1))
        done
        if mv "$log_path" "$candidate"; then
            previous="$candidate"
        else
            previous="move_failed:$candidate"
        fi
    fi

    : > "$log_path"
    {
        echo "[relay-bridge] diagnostic log started at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
        echo "[relay-bridge] previous_log=$previous reason=$reason provider=$provider cwd=$cwd"
    } >> "$log_path"
}

# Relay records the sha256 of every command/skill file it writes, so a later
# refresh can tell an unmodified Relay install (safe to replace with the
# shipped version) from a user edit (kept), whether or not the edit left
# Relay's own text in place.
RELAY_COMMAND_MANIFEST="$USER_DATA_DIR/installed-commands.sha256"
# sha256 prefixes of every command/skill body shipped before that record
# existed (the git history of these heredocs and of the ones relay-orchestrator
# used to carry, bridge paths left as placeholders). A pre-record file matching
