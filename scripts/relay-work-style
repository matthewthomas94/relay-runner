#!/bin/bash
# Show or set the session's Relay work style; shared by Codex and Claude.
# Runs `relay-rs work-style` (RR-487): $RELAY_RS_BIN, the app bundle's copy beside
# these scripts, then a source checkout's cargo build.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
for candidate in "${RELAY_RS_BIN:-}" \
    "$PROJECT_ROOT/../MacOS/relay-rs" \
    "$PROJECT_ROOT/rust/target/aarch64-apple-darwin/release/relay-rs" \
    "$PROJECT_ROOT/rust/target/release/relay-rs" \
    "$PROJECT_ROOT/rust/target/debug/relay-rs"; do
    if [[ -n "$candidate" && -f "$candidate" && -x "$candidate" ]]; then
        exec "$candidate" work-style "$@"
    fi
done
echo "relay-work-style requires relay-rs from Relay Runner.app (or build rust/ with cargo)" >&2
exit 1
