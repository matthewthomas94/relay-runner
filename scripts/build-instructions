#!/usr/bin/env python3
"""Bake the Relay behavioral-rule chunks into the MCP servers and CLAUDE.md.

Single source of truth lives in `services/instructions/*.md`. This script:

  1. Concatenates the relevant chunks per MCP server and writes a Swift
     constant (`Instructions.generated.swift`) into each target so the rules
     ship inside the binary — no filesystem dependency at runtime.
  2. Regenerates the behavioral block of the repo-root `CLAUDE.md` between
     the BEGIN/END GENERATED markers, leaving the hand-edited preamble and
     postamble untouched.
  3. Bakes the compact `claude-code` payloads from
     `services/instructions/compact/` and fails if any exceeds Claude Code's
     2048-character MCP instruction cap.

Run it after editing any chunk. It is idempotent. Checked-in generated
artifacts must match this script's output (a CI/pre-commit check can diff).
"""

import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
CHUNKS = REPO / "services" / "instructions"

# Which chunks each MCP server's `instructions` payload concatenates, in order.
ACTIONS = [
    "relay-actions-vs-computer-use",
    "propose-action",
    "board-hotkey",
    "look-at-screen-intent",
    "naming",
]
ORCHESTRATOR = [
    "orchestration-workflow",
    "program-manager-capture",
    "recovery-401-auth",
    "naming",
]
# Claude Code keeps only the first 2048 characters (UTF-16 units) of each MCP
# server's `initialize` instructions and appends "… [truncated]". `claude-code`
# clients therefore get the compact payload in compact/<server>.md and fetch
# the full rules with the server's read-only `get_relay_instructions` tool.
# Every other client keeps the payloads above byte for byte.
CLAUDE_INSTRUCTIONS_LIMIT = 2048
COMPACT_SERVERS = ["relay-actions", "relay-orchestrator", "relay-vision"]
# Full rules relay-orchestrator's `get_relay_instructions` returns to Claude.
# relay-actions returns its ACTIONS payload unchanged.
ORCHESTRATOR_CLAUDE = [
    "subscription-only",
    "orchestration-workflow",
    "artifact-tickets",
    "program-manager-capture",
    "recovery-401-auth",
    "naming",
]
# Order the chunks appear in CLAUDE.md's generated block.
CLAUDE_MD = [
    "subscription-only",
    "orchestration-workflow",
    "artifact-tickets",
    "program-manager-capture",
    "recovery-401-auth",
    "relay-actions-vs-computer-use",
    "board-hotkey",
    "look-at-screen-intent",
    "propose-action",
    "naming",
]

BEGIN = "<!-- BEGIN GENERATED: relay behavioral rules — edit services/instructions/, not here -->"
END = "<!-- END GENERATED -->"


def load(name: str) -> str:
    return (CHUNKS / f"{name}.md").read_text().strip()


def concat(names) -> str:
    return "\n\n".join(load(n) for n in names) + "\n"


def compact(server: str) -> str:
    return load(f"compact/{server}") + "\n"


def oversized_compacts() -> list:
    errors = []
    for server in COMPACT_SERVERS:
        # Claude Code measures JavaScript string length, i.e. UTF-16 units.
        size = len(compact(server).rstrip("\n").encode("utf-16-le")) // 2
        if size > CLAUDE_INSTRUCTIONS_LIMIT:
            errors.append(
                f"compact/{server}.md is {size} characters "
                f"(Claude Code limit {CLAUDE_INSTRUCTIONS_LIMIT})"
            )
    return errors


def swift_constant(constants: dict, server: str) -> str:
    # Raw multiline literal (#"""..."""#) — no escaping of backslashes, quotes,
    # or backticks in the markdown. Guard against the (unlikely) closing
    # delimiter appearing in content.
    if any('"""#' in payload for payload in constants.values()):
        sys.exit("chunk content contains a Swift raw-string close delimiter")
    body = "\n".join(
        f"    static let {name} = #\"\"\"\n{payload}\"\"\"#\n"
        for name, payload in constants.items()
    )
    return (
        "// GENERATED by scripts/build-instructions — do not edit by hand.\n"
        f"// Source of truth: services/instructions/ (chunks for {server}).\n\n"
        "enum Instructions {\n"
        f"{body}"
        "}\n"
    )


def write_if_changed(path: Path, content: str) -> bool:
    if path.exists() and path.read_text() == content:
        return False
    path.write_text(content)
    return True


def regen_claude_md(block: str) -> bool:
    path = REPO / "CLAUDE.md"
    text = path.read_text()
    if BEGIN not in text or END not in text:
        sys.exit("CLAUDE.md is missing the BEGIN/END GENERATED markers")
    pre, rest = text.split(BEGIN, 1)
    _, post = rest.split(END, 1)
    new = f"{pre}{BEGIN}\n\n{block}\n{END}{post}"
    return write_if_changed(path, new)


def main() -> None:
    check = "--check" in sys.argv
    oversized = oversized_compacts()
    if oversized:
        print("COMPACT PAYLOAD TOO LONG:\n  " + "\n  ".join(oversized))
        sys.exit(1)
    targets = {
        REPO / "Sources" / "relay-actions-mcp" / "Instructions.generated.swift":
            swift_constant({
                "payload": concat(ACTIONS),
                "claudeCompact": compact("relay-actions"),
            }, "relay-actions"),
        REPO / "Sources" / "relay-orchestrator-mcp" / "Instructions.generated.swift":
            swift_constant({
                "payload": concat(ORCHESTRATOR),
                "claudeCompact": compact("relay-orchestrator"),
                "claudeFull": concat(ORCHESTRATOR_CLAUDE),
            }, "relay-orchestrator"),
        REPO / "Sources" / "relay-vision-mcp" / "Instructions.generated.swift":
            swift_constant({
                "claudeCompact": compact("relay-vision"),
            }, "relay-vision"),
    }
    drifted = []
    for path, content in targets.items():
        if check:
            if not path.exists() or path.read_text() != content:
                drifted.append(str(path.relative_to(REPO)))
        elif write_if_changed(path, content):
            print(f"wrote {path.relative_to(REPO)}")

    claude_block = concat(CLAUDE_MD).rstrip() + "\n"
    if check:
        text = (REPO / "CLAUDE.md").read_text()
        if BEGIN in text and END in text:
            current = text.split(BEGIN, 1)[1].split(END, 1)[0].strip()
            if current != claude_block.strip():
                drifted.append("CLAUDE.md")
        else:
            drifted.append("CLAUDE.md (markers missing)")
        if drifted:
            print("DRIFT — run scripts/build-instructions:\n  " + "\n  ".join(drifted))
            sys.exit(1)
        print("instructions in sync")
    else:
        if regen_claude_md(claude_block):
            print("wrote CLAUDE.md (generated block)")


if __name__ == "__main__":
    main()
