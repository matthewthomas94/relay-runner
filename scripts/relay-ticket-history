#!/bin/bash
# Agent-facing archive setup and retrieval, shared by Codex and Claude.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
for candidate in "$HOME/Library/Application Support/relay-runner/python/bin/python3" \
    "$HOME/Library/Application Support/relay-runner/services/.venv/bin/python" \
    /opt/homebrew/bin/python3 /usr/local/bin/python3; do
    if [[ -x "$candidate" ]] && "$candidate" -c 'import tomllib' >/dev/null 2>&1; then
        exec "$candidate" -B "$PROJECT_ROOT/services/artifact_history_cli.py" "$@"
    fi
done
echo "relay-ticket-history requires Relay's bundled Python or Python 3.11+" >&2
exit 1
